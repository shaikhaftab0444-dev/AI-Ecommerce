@model BrandsStore.ViewModel.ResetPasswordViewModel

@{
    ViewData["Title"] = "Password Reset Successful";
}

<style>
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes checkmark {
        0% {
            stroke-dashoffset: 100;
        }
        100% {
            stroke-dashoffset: 0;
        }
    }

    @@keyframes scale {
        0%, 100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.1);
        }
    }

    .success-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        padding: 2rem 0;
    }

    .success-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        max-width: 500px;
        width: 100%;
        padding: 3rem;
        text-align: center;
        animation: fadeInUp 0.6s ease-out;
    }

    .success-icon {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
        animation: scale 2s ease-in-out infinite;
    }

    .checkmark {
        width: 50px;
        height: 50px;
    }

    .checkmark-circle {
        stroke-dasharray: 166;
        stroke-dashoffset: 166;
        stroke-width: 2;
        stroke: white;
        fill: none;
        animation: checkmark 0.6s ease-in-out 0.4s forwards;
    }

    .checkmark-check {
        stroke-dasharray: 48;
        stroke-dashoffset: 48;
        stroke-width: 3;
        stroke: white;
        fill: none;
        animation: checkmark 0.3s ease-in-out 0.8s forwards;
    }

    .success-title {
        font-size: 2rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 1rem;
    }

    .success-message {
        color: #6b7280;
        font-size: 1.1rem;
        margin-bottom: 2rem;
    }

    .btn-login {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
        border-radius: 10px;
        padding: 0.875rem 2rem;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
        font-size: 1.1rem;
        text-decoration: none;
        display: inline-block;
    }

    .btn-login:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.6);
        color: white;
    }

    .redirect-info {
        margin-top: 1.5rem;
        color: #6b7280;
        font-size: 0.9rem;
    }

    @@media (max-width: 576px) {
        .success-card {
            padding: 2rem 1.5rem;
            margin: 1rem;
        }

        .success-title {
            font-size: 1.5rem;
        }

        .success-icon {
            width: 80px;
            height: 80px;
        }
    }
</style>

<div class="success-container">
    <div class="success-card">
        <div class="success-icon">
            <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                <circle class="checkmark-circle" cx="26" cy="26" r="25" />
                <path class="checkmark-check" d="M14.1 27.2l7.1 7.2 16.7-16.8" />
            </svg>
        </div>

        <h1 class="success-title">Password Reset Successful!</h1>
        <p class="success-message">
            Your password has been successfully reset. You can now login with your new password.
        </p>

        <a asp-action="Login" class="btn-login">
            <i class="fas fa-sign-in-alt me-2"></i>Go to Login
        </a>

        <div class="redirect-info">
            <i class="fas fa-info-circle me-1"></i>
            Redirecting to login in <span id="countdown">5</span> seconds...
        </div>
    </div>
</div>

<script>
    let seconds = 5;
    const countdownElement = document.getElementById('countdown');

    const countdown = setInterval(function() {
        seconds--;
        countdownElement.textContent = seconds;

        if (seconds <= 0) {
            clearInterval(countdown);
            window.location.href = '@Url.Action("Login")';
        }
    }, 1000);
</script>