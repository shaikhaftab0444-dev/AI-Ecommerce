@model BrandsStore.ViewModel.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<style>
    :root{
        --ink:#0a0a0f;--ink-soft:#3a3a4a;--ink-muted:#7a7a8c;
        --surface:#fff;--surface-2:#f4f4f8;--surface-3:#e6e6ee;
        --accent:#e8365d;--accent-dark:#c42548;--accent-glow:rgba(232,54,93,.09);
        --green:#00b074;--green-glow:rgba(0,176,116,.09);
        --blue:#3b82f6;--blue-glow:rgba(59,130,246,.09);
        --tr:all .3s cubic-bezier(.4,0,.2,1);
    }
    *{box-sizing:border-box;}

    .auth-page{
        font-family:'DM Sans',sans-serif;
        min-height:100vh;
        background:var(--surface-2);
        display:flex;
        align-items:center;
        justify-content:center;
        padding:40px 16px;
    }

    /* SPLIT LAYOUT */
    .auth-wrap{
        display:grid;
        grid-template-columns:1fr 420px;
        max-width:900px;
        width:100%;
        background:#fff;
        border-radius:24px;
        overflow:hidden;
        box-shadow:0 24px 80px rgba(0,0,0,.13);
        border:1px solid var(--surface-3);
    }

    /* LEFT PANEL */
    .auth-panel{
        position:relative;
        overflow:hidden;
        background:var(--ink);
        padding:52px 44px;
        display:flex;
        flex-direction:column;
        justify-content:space-between;
    }
    .auth-panel::before{
        content:'';position:absolute;inset:0;
        background:radial-gradient(circle at 30% 30%,rgba(232,54,93,.22) 0%,transparent 55%),
                   radial-gradient(circle at 80% 80%,rgba(139,92,246,.14) 0%,transparent 45%);
    }
    .auth-panel::after{
        content:'';position:absolute;inset:0;
        background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),
                         linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);
        background-size:36px 36px;
    }
    .panel-content{position:relative;z-index:1;}
    .panel-logo{
        font-family:'Playfair Display',serif;
        font-size:1.5rem;font-weight:900;color:#fff;
        text-decoration:none;display:inline-flex;align-items:center;gap:10px;
        margin-bottom:52px;
    }
    .panel-logo-dot{width:8px;height:8px;border-radius:50%;background:var(--accent);display:inline-block;}
    .panel-tag{font-size:11px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:2px;margin-bottom:12px;display:flex;align-items:center;gap:7px;}
    .panel-tag::before{content:'';width:16px;height:2px;background:var(--accent);border-radius:1px;}
    .panel-title{font-family:'Playfair Display',serif;font-size:clamp(1.6rem,3vw,2.2rem);font-weight:900;color:#fff;margin:0 0 14px;line-height:1.2;}
    .panel-title em{font-style:italic;color:var(--accent);}
    .panel-sub{font-size:13px;color:rgba(255,255,255,.45);line-height:1.7;margin:0;}
    .panel-features{margin-top:40px;display:flex;flex-direction:column;gap:14px;}
    .pf-item{display:flex;align-items:center;gap:12px;}
    .pf-ico{width:32px;height:32px;border-radius:8px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;font-size:13px;color:rgba(255,255,255,.7);flex-shrink:0;}
    .pf-text{font-size:12px;color:rgba(255,255,255,.5);line-height:1.5;}
    .pf-text strong{color:rgba(255,255,255,.8);display:block;font-size:13px;}

    /* FORM SIDE */
    .auth-form-wrap{padding:48px 40px;display:flex;flex-direction:column;justify-content:center;}
    .auth-form-title{font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:700;color:var(--ink);margin:0 0 4px;}
    .auth-form-sub{font-size:13px;color:var(--ink-muted);margin:0 0 32px;}

    /* VALIDATION SUMMARY */
    .val-summary{background:rgba(232,54,93,.07);border:1px solid rgba(232,54,93,.2);border-radius:10px;padding:12px 16px;margin-bottom:20px;font-size:13px;color:var(--accent);}

    /* FIELD GROUPS */
    .fg{display:flex;flex-direction:column;gap:6px;margin-bottom:18px;}
    .fl{font-size:11px;font-weight:800;color:var(--ink);text-transform:uppercase;letter-spacing:.6px;}
    .input-wrap{position:relative;}
    .input-wrap i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--ink-muted);font-size:13px;pointer-events:none;}
    .fi{
        width:100%;background:var(--surface-2);border:1.5px solid var(--surface-3);
        border-radius:10px;padding:11px 14px 11px 40px;
        font-family:'DM Sans',sans-serif;font-size:13px;color:var(--ink);
        outline:none;transition:var(--tr);
    }
    .fi:focus{border-color:var(--accent);background:#fff;box-shadow:0 0 0 3px var(--accent-glow);}
    .field-error{font-size:11px;color:var(--accent);margin-top:3px;}

    /* REMEMBER ROW */
    .remember-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;}
    .check-label{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-soft);cursor:pointer;}
    .check-label input[type=checkbox]{width:16px;height:16px;border-radius:4px;accent-color:var(--accent);cursor:pointer;}
    .forgot-link{font-size:12px;font-weight:700;color:var(--accent);text-decoration:none;transition:var(--tr);}
    .forgot-link:hover{color:var(--accent-dark);}

    /* SUBMIT BUTTON */
    .btn-submit{
        width:100%;padding:13px;background:var(--accent);color:#fff;
        border:none;border-radius:100px;font-family:'DM Sans',sans-serif;
        font-size:14px;font-weight:800;cursor:pointer;transition:var(--tr);
        display:flex;align-items:center;justify-content:center;gap:8px;
        margin-bottom:24px;
    }
    .btn-submit:hover{background:var(--accent-dark);transform:translateY(-2px);box-shadow:0 10px 26px rgba(232,54,93,.3);}

    /* DIVIDER */
    .auth-divider{display:flex;align-items:center;gap:12px;margin-bottom:20px;}
    .auth-divider::before,.auth-divider::after{content:'';flex:1;height:1px;background:var(--surface-3);}
    .auth-divider span{font-size:11px;font-weight:700;color:var(--ink-muted);text-transform:uppercase;letter-spacing:.5px;}

    /* REGISTER LINK */
    .register-row{text-align:center;font-size:13px;color:var(--ink-muted);}
    .register-row a{font-weight:800;color:var(--ink);text-decoration:none;transition:var(--tr);}
    .register-row a:hover{color:var(--accent);}

    /* TRUST BADGE */
    .trust-row{display:flex;align-items:center;justify-content:center;gap:6px;margin-top:20px;font-size:11px;color:var(--ink-muted);}
    .trust-row i{color:var(--green);}

    @@keyframes fadeUp{from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:translateY(0);}}
    .auth-wrap{animation:fadeUp .5s ease-out both;}

    @@media(max-width:700px){
        .auth-wrap{grid-template-columns:1fr;}
        .auth-panel{display:none;}
        .auth-form-wrap{padding:36px 28px;}
    }
</style>

<div class="auth-page">
    <div class="auth-wrap">

        <!-- LEFT PANEL -->
        <div class="auth-panel">
            <div class="panel-content">
                <a asp-controller="Home" asp-action="Index" class="panel-logo">
                    <div class="panel-logo-dot"></div>
                    BrandsStore
                </a>
                <div class="panel-tag"><i class="fas fa-crown"></i> Welcome Back</div>
                <h2 class="panel-title">Your Style,<br><em>Your Story.</em></h2>
                <p class="panel-sub">Sign in to access your curated collection, track orders, and discover new arrivals crafted just for you.</p>
                <div class="panel-features">
                    <div class="pf-item">
                        <div class="pf-ico"><i class="fas fa-box"></i></div>
                        <div class="pf-text"><strong>Track Your Orders</strong>Real-time updates on every purchase.</div>
                    </div>
                    <div class="pf-item">
                        <div class="pf-ico"><i class="fas fa-heart"></i></div>
                        <div class="pf-text"><strong>Save Favourites</strong>Build your personal wishlist.</div>
                    </div>
                    <div class="pf-item">
                        <div class="pf-ico"><i class="fas fa-tag"></i></div>
                        <div class="pf-text"><strong>Exclusive Offers</strong>Member-only deals and early access.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- FORM SIDE -->
        <div class="auth-form-wrap">
            <div class="auth-form-title">Sign In</div>
            <div class="auth-form-sub">Enter your credentials to continue</div>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="val-summary" style="display:none;"></div>

                <div class="fg">
                    <label class="fl">Email Address</label>
                    <div class="input-wrap">
                        <i class="fas fa-envelope"></i>
                        <input asp-for="Email" class="fi" placeholder="your@email.com" />
                    </div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="fg">
                    <label class="fl">Password</label>
                    <div class="input-wrap">
                        <i class="fas fa-lock"></i>
                        <input asp-for="Password" class="fi" placeholder="Enter your password" />
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="remember-row">
                    <label class="check-label">
                        <input asp-for="RememberMe" type="checkbox" />
                        Remember me
                    </label>
                    <a asp-action="ForgotPassword" class="forgot-link">Forgot password?</a>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="fas fa-sign-in-alt"></i> Sign In
                </button>
            </form>

            <div class="auth-divider"><span>or</span></div>

            <div class="register-row">
                Don't have an account? <a asp-action="Register">Create one here</a>
            </div>

            <div class="trust-row">
                <i class="fas fa-shield-alt"></i>
                SSL secured — your data is always safe
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show validation summary only if it has content
        const vs = document.querySelector('.val-summary');
        if (vs && vs.innerText.trim()) vs.style.display = 'block';
    </script>
}
