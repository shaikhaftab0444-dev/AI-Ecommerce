@model BrandsStore.ViewModel.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Link Expired";
}

<style>
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes shake {
        0%, 100% { transform: rotate(0deg); }
        25% { transform: rotate(-5deg); }
        75% { transform: rotate(5deg); }
    }

    .error-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        padding: 2rem 0;
    }

    .error-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        max-width: 500px;
        width: 100%;
        padding: 3rem;
        text-align: center;
        animation: fadeInUp 0.6s ease-out;
    }

    .error-icon {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
        animation: shake 2s ease-in-out infinite;
    }

    .error-icon i {
        font-size: 3rem;
        color: white;
    }

    .error-title {
        font-size: 2rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 1rem;
    }

    .error-message {
        color: #6b7280;
        font-size: 1.1rem;
        margin-bottom: 2rem;
    }

    .btn-try-again {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        border: none;
        border-radius: 10px;
        padding: 0.875rem 2rem;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4);
        font-size: 1.1rem;
        text-decoration: none;
        display: inline-block;
    }

    .btn-try-again:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(239, 68, 68, 0.6);
        color: white;
    }

    .back-link {
        margin-top: 1.5rem;
    }

    .back-link a {
        color: #6b7280;
        text-decoration: none;
        font-weight: 600;
    }

    .back-link a:hover {
        color: #ef4444;
    }

    @@media (max-width: 576px) {
        .error-card {
            padding: 2rem 1.5rem;
            margin: 1rem;
        }

        .error-title {
            font-size: 1.5rem;
        }

        .error-icon {
            width: 80px;
            height: 80px;
        }

        .error-icon i {
            font-size: 2.5rem;
        }
    }
</style>

<div class="error-container">
    <div class="error-card">
        <div class="error-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>

        <h1 class="error-title">Link Expired</h1>
        <p class="error-message">
            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                @ViewBag.ErrorMessage
            }
            else
            {
                <text>This password reset link has expired or is invalid. Please request a new one.</text>
            }
        </p>

        <a asp-action="ForgotPassword" class="btn-try-again">
            <i class="fas fa-redo me-2"></i>Request New Link
        </a>

        <div class="back-link">
            <a asp-action="Login">
                <i class="fas fa-arrow-left me-2"></i>Back to Login
            </a>
        </div>
    </div>
</div>