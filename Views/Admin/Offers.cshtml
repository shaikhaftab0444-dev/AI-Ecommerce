                    <label class="fl">Background Image <span class="fl-opt">(optional · fills entire slide bg)</span></label>
                    <div class="dz" id="c_bz" ondragover="dzOver(event,'c_bz')" ondragleave="dzLeave('c_bz')" ondrop="dzDrop(event,'c_bz','c_bf','c_bp','c_bc')">
