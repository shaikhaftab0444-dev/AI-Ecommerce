    }
</style>

<div class="of-page">

    <div class="of-hero">
        <div class="of-hero-l">
            <div class="of-hero-tag"><i class="fas fa-bullhorn"></i> Admin</div>
            <h1 class="of-hero-title">Manage <em>Offers</em></h1>
            <p class="of-hero-sub">@total offer@(total == 1 ? "" : "s") · @active active · Shown as hero slides on home page</p>
        </div>
        <div class="of-hero-r">
            <button class="btn-new" onclick="openCreate()"><i class="fas fa-plus"></i> Add New Offer</button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-ok"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-err"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>
    }

    <div class="stat-row">
        <div class="sc c-blue"><div class="sc-bar"></div><div class="sc-ico"><i class="fas fa-bullhorn"></i></div><div class="sc-val">@total</div><div class="sc-lbl">Total Offers</div></div>
        <div class="sc c-green"><div class="sc-bar"></div><div class="sc-ico"><i class="fas fa-eye"></i></div><div class="sc-val">@active</div><div class="sc-lbl">Active / Visible</div></div>
        <div class="sc c-gold"><div class="sc-bar"></div><div class="sc-ico"><i class="fas fa-eye-slash"></i></div><div class="sc-val">@(total - active)</div><div class="sc-lbl">Inactive</div></div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="of-grid">
            @foreach (var offer in Model.OrderBy(o => o.SortOrder).ThenByDescending(o => o.CreatedAt))
            {
                <div class="oc">
                    <div class="oc-preview">
                        <div class="oc-abar" style="background:@offer.AccentColor;"></div>

                        @if (!string.IsNullOrEmpty(offer.BackgroundImageUrl))
                        {
                            <img class="oc-img" src="@offer.BackgroundImageUrl" alt=""
                                 onerror="this.style.display='none'" />
                        }
                        else if (!string.IsNullOrEmpty(offer.ImageUrl))
                        {
                            <img class="oc-img" src="@offer.ImageUrl" alt="@offer.Title"
                                 onerror="this.style.display='none'" />
                        }
                        else
                        {
                            <div class="oc-placeholder"><i class="fas fa-image" style="font-size:2rem;color:rgba(255,255,255,.15);"></i></div>
                        }

                        <div class="oc-overlay"></div>
                        <div class="oc-text">
                            @if (!string.IsNullOrEmpty(offer.EyebrowText))
                            {
                                <div class="oc-eyebrow">@offer.EyebrowText</div>
                            }
                            <div class="oc-title">@offer.Title</div>
                            <div class="oc-sub">@offer.Subtitle</div>
                        </div>
                        @if (!string.IsNullOrEmpty(offer.BadgeText))
                        {
                            <div class="oc-badge">@offer.BadgeText</div>
                        }
                        @if (!string.IsNullOrEmpty(offer.BackgroundImageUrl))
                        {
                            <div class="oc-bgtag"><i class="fas fa-image"></i> BG</div>
                        }
                    </div>

                    <div class="oc-body">
                        <div class="oc-meta">
                            <span class="mp @(offer.IsActive ? "mp-on" : "mp-off")"><i class="fas fa-circle" style="font-size:7px;"></i> @(offer.IsActive ? "Active" : "Inactive")</span>
                            <span class="mp mp-ord"><i class="fas fa-sort-amount-up"></i> #@offer.SortOrder</span>
                            @if (!string.IsNullOrEmpty(offer.BackgroundImageUrl))
                            {
                                <span class="mp mp-bg"><i class="fas fa-image"></i> BG</span>
                            }
                        </div>
                        <div class="oc-desc">@(string.IsNullOrEmpty(offer.Description) ? "No description." : (offer.Description.Length > 90 ? offer.Description[..90] + "…" : offer.Description))</div>
                        <div class="oc-btns">
                            <button class="btn-edit" onclick="openEdit(@offer.OfferId)"><i class="fas fa-pencil-alt"></i> Edit</button>
                            <form asp-action="ToggleOffer" method="post" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@offer.OfferId" />
                                <button type="submit" class="btn-tog @(offer.IsActive ? "" : "grn")" title="@(offer.IsActive ? "Deactivate" : "Activate")">
                                    <i class="fas @(offer.IsActive ? "fa-eye-slash" : "fa-eye")"></i>
                                </button>
                            </form>
                            <form asp-action="DeleteOffer" method="post" style="margin:0;" onsubmit="return confirm('Delete this offer permanently?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@offer.OfferId" />
                                <button type="submit" class="btn-del"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="of-empty">
            <div class="of-empty-ico"><i class="fas fa-bullhorn"></i></div>
            <h3>No Offers Yet</h3>
            <p>Create your first offer — it will appear as a hero carousel slide on the home page.</p>
            <button class="btn-new" onclick="openCreate()"><i class="fas fa-plus"></i> Create First Offer</button>
        </div>
    }
</div>

<!-- ══════════════════════
     CREATE MODAL
══════════════════════ -->
<div class="modal-ov" id="createModal">
    <div class="modal-box">
        <div class="mhdr">
            <div>
                <div class="m-title">Create New Offer</div>
