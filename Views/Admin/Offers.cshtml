@model IEnumerable<BrandsStore.Models.Offer>

@{
    ViewData["Title"] = "Manage Offers";
    int total = Model?.Count() ?? 0;
    int active = Model?.Count(o => o.IsActive) ?? 0;

    var offersJson = System.Text.Json.JsonSerializer.Serialize(
        Model?.Select(o => new
        {
            o.OfferId,
            o.Title,
            o.Subtitle,
            o.Description,
            o.BadgeText,
            o.EyebrowText,
            o.PrimaryButtonText,
            o.PrimaryButtonUrl,
            o.SecondaryButtonText,
            o.SecondaryButtonUrl,
            o.ImageUrl,
            o.BackgroundImageUrl,
            o.AccentColor,
            o.Pill1Title,
            o.Pill1Subtitle,
            o.Pill2Title,
            o.Pill2Subtitle,
            o.IsActive,
            o.SortOrder
        }) ?? Enumerable.Empty<object>()
    );
}

<style>
