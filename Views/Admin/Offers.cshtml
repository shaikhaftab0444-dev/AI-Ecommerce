            </div>
            <button class="m-close" onclick="closeCreate()"><i class="fas fa-times"></i></button>
        </div>

        <form asp-action="CreateOffer" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="fgr">
