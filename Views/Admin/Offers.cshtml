@section Scripts {
    <script>
        const OFFERS = @Html.Raw(offersJson);

        /* ── MODAL ── */
        function openCreate()  { show('createModal'); }
        function closeCreate() { hide('createModal'); }
        function openEdit(id)  { loadEdit(id); show('editModal'); }
        function closeEdit()   { hide('editModal'); }
        function show(id){ document.getElementById(id).classList.add('show'); document.body.style.overflow='hidden'; }
        function hide(id){ document.getElementById(id).classList.remove('show'); document.body.style.overflow=''; }
        ['createModal','editModal'].forEach(id =>
            document.getElementById(id).addEventListener('click', e => { if(e.target===e.currentTarget) hide(id); })
        );

        /* ── LOAD EDIT ── */
        function loadEdit(id) {
            const o = OFFERS.find(x => x.offerId === id);
            if (!o) return;
            g('e_id').value      = o.offerId;
            g('e_title').value   = o.title       || '';
            g('e_subtitle').value= o.subtitle    || '';
            g('e_desc').value    = o.description || '';
            g('e_eyebrow').value = o.eyebrowText || '';
            g('e_badge').value   = o.badgeText   || '';
            g('e_pt').value      = o.primaryButtonText   || '';
            g('e_pu').value      = o.primaryButtonUrl    || '';
            g('e_st').value      = o.secondaryButtonText || '';
            g('e_su').value      = o.secondaryButtonUrl  || '';
            g('e_p1t').value     = o.pill1Title    || '';
            g('e_p1s').value     = o.pill1Subtitle || '';
            g('e_p2t').value     = o.pill2Title    || '';
            g('e_p2s').value     = o.pill2Subtitle || '';
            g('e_sort').value    = o.sortOrder;
            g('e_ac').value      = o.accentColor   || '#e8365d';
            g('e_active').checked= o.isActive;

            // Keep existing images in hidden fields
            g('e_imgUrl').value  = o.imageUrl           || '';
            g('e_bgUrl').value   = o.backgroundImageUrl || '';

            // Show current hero thumbnail
            const hc = g('e_hcurr');
            if (o.imageUrl) { g('e_hcurr_img').src=o.imageUrl; hc.style.display='block'; }
            else hc.style.display='none';

            // Show current bg thumbnail
            const bc = g('e_bcurr');
            if (o.backgroundImageUrl) { g('e_bcurr_img').src=o.backgroundImageUrl; bc.style.display='block'; }
            else bc.style.display='none';

            // Reset upload zones
            dzClear('e_hf','e_hz','e_hp','e_hc');
            dzClear('e_bf','e_bz','e_bp','e_bc');

            // Sync swatches
            document.querySelectorAll('#e_swatches .sw').forEach(sw =>
                sw.classList.toggle('sel', sw.dataset.c === o.accentColor)
            );
            g('e_sub').textContent = `Editing: "${o.title}"`;
        }

        function clearCurrHero(){ g('e_hcurr').style.display='none'; g('e_imgUrl').value=''; }
        function clearCurrBg()  { g('e_bcurr').style.display='none'; g('e_bgUrl').value='';  }

        /* ── DRAG & DROP ── */
        function dzOver(e, zid){ e.preventDefault(); g(zid).classList.add('over'); }
        function dzLeave(zid)  { g(zid).classList.remove('over'); }

        function dzDrop(e, zid, fid, pid, cid) {
            e.preventDefault();
            g(zid).classList.remove('over');
            const f = e.dataTransfer.files[0];
            if (!f || !f.type.startsWith('image/')) return;
            const dt = new DataTransfer();
            dt.items.add(f);
            g(fid).files = dt.files;
            showPrev(f, zid, pid, cid);
        }
        function dzChange(inp, zid, pid, cid) {
            if (inp.files && inp.files[0]) showPrev(inp.files[0], zid, pid, cid);
        }
        function showPrev(file, zid, pid, cid) {
            const r = new FileReader();
            r.onload = ev => {
                g(pid).querySelector('img').src = ev.target.result;
                g(pid).style.display  = 'block';
                g(cid).style.display  = 'inline-block';
                g(zid).classList.add('has');
            };
            r.readAsDataURL(file);
        }
        function dzClear(fid, zid, pid, cid) {
            const inp=g(fid), prev=g(pid), clr=g(cid), zone=g(zid);
            if(inp)  inp.value='';
            if(prev) prev.style.display='none';
            if(clr)  clr.style.display='none';
            if(zone) zone.classList.remove('has','over');
        }

        /* ── SWATCH PICKER ── */
        function pickSwatch(el, inputId) {
            g(inputId).value = el.dataset.c;
            el.closest('.swatches').querySelectorAll('.sw').forEach(s => s.classList.remove('sel'));
            el.classList.add('sel');
        }

        function g(id){ return document.getElementById(id); }
    </script>
}
