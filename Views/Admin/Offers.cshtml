                        <div class="dz-ico"><i class="fas fa-image"></i></div>
                        <p>Drag & drop or click</p>
                        <span>Displayed behind slide content</span>
                        <div class="dz-prev" id="c_bp"><img id="c_bpi" src="" alt="" /></div>
                    </div>
                    <button type="button" class="dz-clr" id="c_bc" onclick="dzClear('c_bf','c_bz','c_bp','c_bc')">✕ Remove image</button>
                </div>
            </div>

            <div class="mdiv"><span>Floating Pills</span></div>
            <div class="fgr">
                <div class="fg fg0"><label class="fl">Pill 1 Title</label><input type="text" name="Pill1Title" class="fi" placeholder="Mega Sale" /></div>
                <div class="fg fg0"><label class="fl">Pill 1 Subtitle</label><input type="text" name="Pill1Subtitle" class="fi" placeholder="Up to 50% OFF" /></div>
            </div>
            <div class="fgr">
                <div class="fg fg0"><label class="fl">Pill 2 Title</label><input type="text" name="Pill2Title" class="fi" placeholder="Free Delivery" /></div>
                <div class="fg fg0"><label class="fl">Pill 2 Subtitle</label><input type="text" name="Pill2Subtitle" class="fi" placeholder="Orders over ₹999" /></div>
            </div>

            <div class="mdiv"><span>Appearance</span></div>
            <div class="fgr">
                <div class="fg fg0"><label class="fl">Sort Order <span class="fl-opt">(0 = first)</span></label><input type="number" name="SortOrder" class="fi" value="0" min="0" /></div>
                <div class="fg fg0">
                    <label class="fl">Accent Color</label>
                    <input type="text" name="AccentColor" id="c_ac" class="fi" value="#e8365d" placeholder="#e8365d" />
                    <div class="swatches">
                        @foreach (var c in new[] { "#e8365d", "#3b82f6", "#00b074", "#c9a227", "#8b5cf6", "#f97316", "#06b6d4", "#0a0a0f" })
                        {
                            <div class="sw @(c == "#e8365d" ? "sel" : "")" style="background:@c;" data-c="@c" onclick="pickSwatch(this,'c_ac')"></div>
