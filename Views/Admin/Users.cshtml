@model IEnumerable<BrandsStore.Models.User>

@{
    ViewData["Title"] = "Manage Users";
    int total = Model?.Count() ?? 0;
    int active = Model?.Count(u => u.IsActive) ?? 0;
    int admins = Model?.Count(u => u.Role == "Admin") ?? 0;
    int regular = total - admins;
}

<style>
    :root {
        --ink: #0a0a0f;
        --ink-soft: #3a3a4a;
        --ink-muted: #7a7a8c;
        --surface: #fff;
        --surface-2: #f4f4f8;
        --surface-3: #e6e6ee;
        --accent: #e8365d;
        --accent-dark: #c42548;
        --accent-glow: rgba(232,54,93,.09);
        --gold: #c9a227;
        --gold-glow: rgba(201,162,39,.09);
        --green: #00b074;
        --green-glow: rgba(0,176,116,.09);
        --blue: #3b82f6;
        --blue-glow: rgba(59,130,246,.09);
        --purple: #8b5cf6;
        --purple-glow: rgba(139,92,246,.09);
        --tr: all .3s cubic-bezier(.4,0,.2,1);
    }

    * {
        box-sizing: border-box;
    }

    .up {
        font-family: 'DM Sans',sans-serif;
        background: var(--surface-2);
        min-height: 100vh;
        padding: 28px 28px 56px;
    }

    /* HERO */
    .up-hero {
        position: relative;
        overflow: hidden;
        background: var(--ink);
        border-radius: 22px;
        padding: 30px 40px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
    }

        .up-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 88% 50%,rgba(232,54,93,.16) 0%,transparent 50%),radial-gradient(circle at 12% 80%,rgba(59,130,246,.08) 0%,transparent 40%);
        }

        .up-hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
            background-size: 44px 44px;
        }

    .up-hero-l {
        position: relative;
        z-index: 1;
    }

    .up-hero-tag {
        font-size: 11px;
        font-weight: 700;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 5px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .up-hero-tag::before {
            content: '';
            width: 18px;
            height: 2px;
            background: var(--accent);
            border-radius: 1px;
        }

    .up-hero-title {
        font-family: 'Playfair Display',serif;
        font-size: clamp(1.5rem,3vw,2.1rem);
        font-weight: 900;
        color: #fff;
        margin: 0 0 3px;
    }

        .up-hero-title em {
            font-style: italic;
            color: var(--accent);
        }

    .up-hero-sub {
        font-size: 13px;
        color: rgba(255,255,255,.45);
        margin: 0;
    }

    .up-hero-r {
        position: relative;
        z-index: 1;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 100px;
        padding: 10px 20px;
        color: rgba(255,255,255,.8);
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: var(--tr);
    }

        .btn-back:hover {
            background: rgba(255,255,255,.14);
            color: #fff;
        }

    /* STAT CARDS */
    .stat-row {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 16px;
        margin-bottom: 20px;
    }

    .sc {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--surface-3);
        padding: 22px 20px;
        position: relative;
        overflow: hidden;
        transition: var(--tr);
    }

        .sc:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 40px rgba(0,0,0,.10);
            border-color: transparent;
        }

    .sc-bar {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        border-radius: 16px 16px 0 0;
    }

    .sc.c-red .sc-bar {
        background: var(--accent);
    }

    .sc.c-green .sc-bar {
        background: var(--green);
    }

    .sc.c-blue .sc-bar {
        background: var(--blue);
    }

    .sc.c-purple .sc-bar {
        background: var(--purple);
    }

    .sc-ico {
        width: 42px;
        height: 42px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        margin-bottom: 14px;
    }

    .c-red .sc-ico {
        background: var(--accent-glow);
        color: var(--accent);
    }

    .c-green .sc-ico {
        background: var(--green-glow);
        color: var(--green);
    }

    .c-blue .sc-ico {
        background: var(--blue-glow);
        color: var(--blue);
    }

    .c-purple .sc-ico {
        background: var(--purple-glow);
        color: var(--purple);
    }

    .sc-val {
        font-family: 'Playfair Display',serif;
        font-size: 1.9rem;
        font-weight: 900;
        color: var(--ink);
        line-height: 1;
        margin-bottom: 4px;
    }

    .sc-lbl {
        font-size: 11px;
        font-weight: 700;
        color: var(--ink-muted);
        text-transform: uppercase;
        letter-spacing: .8px;
    }

    /* FILTER BAR */
    .fbar {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--surface-3);
        padding: 16px 22px;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .search-wrap {
        position: relative;
        flex: 1;
        min-width: 200px;
    }

        .search-wrap i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--ink-muted);
            font-size: 13px;
        }

    .search-inp {
        width: 100%;
        background: var(--surface-2);
        border: 1.5px solid var(--surface-3);
        border-radius: 10px;
        padding: 9px 13px 9px 36px;
        font-family: 'DM Sans',sans-serif;
        font-size: 13px;
        color: var(--ink);
        outline: none;
        transition: var(--tr);
    }

        .search-inp:focus {
            border-color: var(--accent);
            background: #fff;
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

    .filter-sel {
        background: var(--surface-2);
        border: 1.5px solid var(--surface-3);
        border-radius: 10px;
        padding: 9px 13px;
        font-family: 'DM Sans',sans-serif;
        font-size: 13px;
        color: var(--ink);
        outline: none;
        transition: var(--tr);
        cursor: pointer;
    }

        .filter-sel:focus {
            border-color: var(--accent);
        }

    .fbar-count {
        font-size: 12px;
        font-weight: 700;
        color: var(--ink-muted);
        white-space: nowrap;
    }

        .fbar-count span {
            color: var(--accent);
        }

    /* TABLE CARD */
    .tc {
        background: #fff;
        border-radius: 18px;
        border: 1px solid var(--surface-3);
        overflow: hidden;
    }

    .tc-head {
        padding: 18px 26px;
        border-bottom: 1px solid var(--surface-3);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .tc-ico {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: var(--blue-glow);
        color: var(--blue);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }

    .tc-title {
        font-family: 'Playfair Display',serif;
        font-size: 1.02rem;
        font-weight: 700;
        color: var(--ink);
        margin: 0;
    }

    .tc-sub {
        font-size: 11px;
        color: var(--ink-muted);
        margin-top: 1px;
    }

    /* TABLE */
    .utable {
        width: 100%;
        border-collapse: collapse;
    }

        .utable thead th {
            padding: 11px 16px;
            font-size: 10px;
            font-weight: 800;
            color: var(--ink-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            background: var(--surface-2);
            border-bottom: 1.5px solid var(--surface-3);
        }

            .utable thead th:first-child {
                padding-left: 26px;
            }

            .utable thead th:last-child {
                padding-right: 26px;
                text-align: center;
            }

        .utable tbody tr {
            border-bottom: 1px solid var(--surface-3);
            transition: var(--tr);
        }

            .utable tbody tr:last-child {
                border-bottom: none;
            }

            .utable tbody tr:hover {
                background: rgba(59,130,246,.025);
            }

        .utable tbody td {
            padding: 14px 16px;
            font-size: 13px;
            color: var(--ink-soft);
            vertical-align: middle;
        }

            .utable tbody td:first-child {
                padding-left: 26px;
            }

            .utable tbody td:last-child {
                padding-right: 26px;
                text-align: center;
            }

    /* Avatar */
    .avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1rem;
        color: #fff;
        flex-shrink: 0;
    }

    .user-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .user-name {
        font-weight: 700;
        color: var(--ink);
        font-size: 13px;
    }

    .user-email {
        font-size: 11px;
        color: var(--ink-muted);
    }

    /* Badges */
    .role-admin {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        border-radius: 100px;
        font-size: 11px;
        font-weight: 700;
        background: var(--accent-glow);
        color: var(--accent);
    }

    .role-user {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        border-radius: 100px;
        font-size: 11px;
        font-weight: 700;
        background: var(--blue-glow);
        color: var(--blue);
    }

    .status-on {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 100px;
        font-size: 11px;
        font-weight: 700;
        background: var(--green-glow);
        color: var(--green);
    }

    .status-off {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 100px;
        font-size: 11px;
        font-weight: 700;
        background: var(--surface-3);
        color: var(--ink-muted);
    }

    .date-txt {
        font-size: 12px;
        color: var(--ink-muted);
    }

    /* Actions */
    .act-wrap {
        display: flex;
        align-items: center;
        gap: 6px;
        justify-content: center;
    }

    .act-btn {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        cursor: pointer;
        text-decoration: none;
        transition: var(--tr);
    }

    .act-view {
        background: var(--blue-glow);
        color: var(--blue);
    }

        .act-view:hover {
            background: var(--blue);
            color: #fff;
        }

    .act-edit {
        background: var(--gold-glow);
        color: var(--gold);
    }

        .act-edit:hover {
            background: var(--gold);
            color: #fff;
        }

    .act-del {
        background: var(--accent-glow);
        color: var(--accent);
    }

        .act-del:hover {
            background: var(--accent);
            color: #fff;
        }

    /* Empty */
    .empty-state {
        padding: 56px 24px;
        text-align: center;
    }

    .empty-ico {
        font-size: 3rem;
        color: var(--surface-3);
        margin-bottom: 14px;
    }

    .empty-title {
        font-family: 'Playfair Display',serif;
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 6px;
    }

    .empty-sub {
        font-size: 13px;
        color: var(--ink-muted);
    }

    /* Delete Modal */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(10,10,15,.6);
        backdrop-filter: blur(4px);
        z-index: 1000;
        display: none;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.show {
            display: flex;
        }

    .modal-box {
        background: #fff;
        border-radius: 22px;
        padding: 36px;
        max-width: 420px;
        width: 90%;
        box-shadow: 0 24px 80px rgba(0,0,0,.2);
        animation: mIn .25s ease-out;
    }

    @@keyframes mIn {
        from {
            opacity: 0;
            transform: scale(.95);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .modal-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: var(--accent-glow);
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin: 0 auto 14px;
    }

    .modal-title {
        font-family: 'Playfair Display',serif;
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--ink);
        text-align: center;
        margin-bottom: 8px;
    }

    .modal-msg {
        font-size: 13px;
        color: var(--ink-muted);
        text-align: center;
        margin-bottom: 22px;
        line-height: 1.6;
    }

        .modal-msg strong {
            color: var(--ink);
        }

    .modal-btns {
        display: flex;
        gap: 10px;
    }

    .btn-modal-cancel {
        flex: 1;
        padding: 11px;
        border: 1.5px solid var(--surface-3);
        border-radius: 100px;
        background: #fff;
        font-family: 'DM Sans',sans-serif;
        font-size: 14px;
        font-weight: 700;
        color: var(--ink);
        cursor: pointer;
        transition: var(--tr);
    }

        .btn-modal-cancel:hover {
            background: var(--ink);
            color: #fff;
            border-color: var(--ink);
        }

    .btn-modal-del {
        flex: 1;
        padding: 11px;
        border: none;
        border-radius: 100px;
        background: var(--accent);
        font-family: 'DM Sans',sans-serif;
        font-size: 14px;
        font-weight: 800;
        color: #fff;
        cursor: pointer;
        transition: var(--tr);
    }

        .btn-modal-del:hover {
            background: var(--accent-dark);
        }

    .pag-wrap {
        padding: 14px 26px;
        border-top: 1px solid var(--surface-3);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }

    .pag-info {
        font-size: 12px;
        color: var(--ink-muted);
    }

        .pag-info span {
            font-weight: 700;
            color: var(--ink);
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .up-hero {
        animation: fadeUp .4s ease-out both;
    }

    .stat-row {
        animation: fadeUp .4s ease-out .07s both;
    }

    .fbar {
        animation: fadeUp .4s ease-out .12s both;
    }

    .tc {
        animation: fadeUp .4s ease-out .17s both;
    }

    @@media(max-width:900px) {
        .stat-row {
            grid-template-columns: 1fr 1fr;
        }

        .up {
            padding: 14px;
        }
    }

    @@media(max-width:500px) {
        .stat-row {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .up-hero {
            padding: 22px 18px;
        }
    }
</style>

<div class="up">

    <!-- HERO -->
    <div class="up-hero">
        <div class="up-hero-l">
            <div class="up-hero-tag"><i class="fas fa-users"></i> Admin Panel</div>
            <h1 class="up-hero-title">Manage <em>Users</em></h1>
            <p class="up-hero-sub">@total registered user(s) in the system</p>
        </div>
        <div class="up-hero-r">
            <a asp-action="Index" class="btn-back"><i class="fas fa-th-large"></i> Dashboard</a>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="stat-row">
        <div class="sc c-blue"><div class="sc-bar"></div><div class="sc-ico"><i class="fas fa-users"></i></div><div class="sc-val">@total</div><div class="sc-lbl">Total Users</div></div>
        <div class="sc c-green"><div class="sc-bar"></div><div class="sc-ico"><i class="fas fa-user-check"></i></div><div class="sc-val">@active</div><div class="sc-lbl">Active Users</div></div>
        <div class="sc c-red"><div class="sc-bar"></div><div class="sc-ico"><i class="fas fa-user-shield"></i></div><div class="sc-val">@admins</div><div class="sc-lbl">Admins</div></div>
        <div class="sc c-purple"><div class="sc-bar"></div><div class="sc-ico"><i class="fas fa-user"></i></div><div class="sc-val">@regular</div><div class="sc-lbl">Customers</div></div>
    </div>

    <!-- FILTER BAR -->
    <div class="fbar">
        <div class="search-wrap">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInp" class="search-inp" placeholder="Search by name or email…" />
        </div>
        <select id="roleFilter" class="filter-sel">
            <option value="">All Roles</option>
            <option value="Admin">Admin</option>
            <option value="User">User</option>
        </select>
        <select id="statusFilter" class="filter-sel">
            <option value="">All Status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
        <div class="fbar-count">Showing <span id="rowCount">@total</span> users</div>
    </div>

    <!-- TABLE CARD -->
    <div class="tc">
        <div class="tc-head">
            <div class="tc-ico"><i class="fas fa-users"></i></div>
            <div>
                <div class="tc-title">All Users</div>
                <div class="tc-sub">View, edit and manage user accounts</div>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="utable" id="userTable">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Joined</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="userBody">
                        @foreach (var u in Model)
                        {
                            // Generate a deterministic color from user id
                            string[] avatarColors = { "#e8365d", "#00b074", "#3b82f6", "#c9a227", "#8b5cf6", "#06b6d4", "#f97316" };
                            string avatarBg = avatarColors[u.UserId % avatarColors.Length];
                            string initial = (u.FullName?.Length > 0 ? u.FullName[0].ToString().ToUpper() : "?");

                            <tr data-name="@u.FullName?.ToLower()" data-email="@u.Email?.ToLower()" data-role="@u.Role" data-status="@(u.IsActive ? "active" : "inactive")">
                                <td>
                                    <div class="user-row">
                                        <div class="avatar" style="background:@avatarBg;">@initial</div>
                                        <div>
                                            <div class="user-name">@u.FullName</div>
                                            <div class="user-email">@u.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (u.Role == "Admin")
                                    {
                                        <span class="role-admin"><i class="fas fa-shield-alt"></i> Admin</span>
                                    }
                                    else
                                    {
                                        <span class="role-user"><i class="fas fa-user"></i> Customer</span>
                                    }
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="status-on"><i class="fas fa-circle" style="font-size:7px;"></i> Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-off"><i class="fas fa-circle" style="font-size:7px;"></i> Inactive</span>
                                    }
                                </td>
                                <td><span class="date-txt">@u.CreatedDate.ToString("dd MMM yyyy")</span></td>
                                <td>
                                    <div class="act-wrap">
                                        <a asp-action="ViewUser" asp-route-id="@u.UserId" class="act-btn act-view" title="View"><i class="fas fa-eye"></i></a>
                                        <a asp-action="EditUser" asp-route-id="@u.UserId" class="act-btn act-edit" title="Edit"><i class="fas fa-edit"></i></a>
                                        @if (u.Role != "Admin")
                                        {
                                            <button type="button" class="act-btn act-del" title="Delete"
                                                    onclick="openDelete(@u.UserId, '@(u.FullName?.Replace("'", "\\'") ?? "")' )">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <div style="width:30px;"></div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-ico"><i class="fas fa-users-slash"></i></div>
                <div class="empty-title">No Users Found</div>
                <div class="empty-sub">No registered users in the system yet.</div>
            </div>
        }

        <div class="pag-wrap">
            <div class="pag-info">Total: <span>@total</span> users — <span>@active</span> active</div>
        </div>
    </div>

</div>

<!-- DELETE MODAL -->
<div class="modal-overlay" id="delModal">
    <div class="modal-box">
        <div class="modal-icon"><i class="fas fa-user-times"></i></div>
        <div class="modal-title">Delete User?</div>
        <div class="modal-msg">You're about to permanently delete <strong id="delName"></strong>. All their data will be removed.</div>
        <div class="modal-btns">
            <button class="btn-modal-cancel" onclick="closeDelete()">Cancel</button>
            <form id="delForm" method="post" style="flex:1;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-modal-del" style="width:100%;"><i class="fas fa-trash"></i> Delete</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDelete(id, name){
            document.getElementById('delName').textContent = name;
            document.getElementById('delForm').action = '/Admin/DeleteUser/' + id;
            document.getElementById('delModal').classList.add('show');
        }
        function closeDelete(){ document.getElementById('delModal').classList.remove('show'); }
        document.getElementById('delModal').addEventListener('click', function(e){ if(e.target===this) closeDelete(); });

        function filterTable(){
            const q   = document.getElementById('searchInp').value.toLowerCase();
            const role = document.getElementById('roleFilter').value;
            const st   = document.getElementById('statusFilter').value;
            const rows = document.querySelectorAll('#userBody tr');
            let visible = 0;
            rows.forEach(r => {
                const name  = r.dataset.name  || '';
                const email = r.dataset.email || '';
                const rRole = r.dataset.role  || '';
                const rSt   = r.dataset.status || '';
                const match = (!q    || name.includes(q) || email.includes(q))
                           && (!role || rRole === role)
                           && (!st   || rSt   === st);
                r.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            document.getElementById('rowCount').textContent = visible;
        }
        document.getElementById('searchInp').addEventListener('input', filterTable);
        document.getElementById('roleFilter').addEventListener('change', filterTable);
        document.getElementById('statusFilter').addEventListener('change', filterTable);
    </script>
}
