@model IEnumerable<BrandsStore.Models.Category>

@{
    ViewData["Title"] = "Manage Categories";
    int total = Model?.Count() ?? 0;
    int active = Model?.Count(c => c.IsActive) ?? 0;
    int inactive = total - active;

    string[] topColors = { "#e8365d", "#3b82f6", "#00b074", "#c9a227", "#8b5cf6", "#06b6d4", "#f97316", "#ec4899" };
    string[] bgColors = { "rgba(232,54,93,.09)", "rgba(59,130,246,.09)", "rgba(0,176,116,.09)", "rgba(201,162,39,.09)", "rgba(139,92,246,.09)", "rgba(6,182,212,.09)", "rgba(249,115,22,.09)", "rgba(236,72,153,.09)" };
    string[] catIcons = { "fa-tshirt", "fa-laptop", "fa-book", "fa-futbol", "fa-gem", "fa-home", "fa-pizza-slice", "fa-palette" };
    int ci = 0;
}

<style>
    :root {
        --ink: #0a0a0f;
        --ink-soft: #3a3a4a;
        --ink-muted: #7a7a8c;
        --surface: #fff;
        --surface-2: #f4f4f8;
        --surface-3: #e6e6ee;
        --accent: #e8365d;
        --accent-dark: #c42548;
        --accent-glow: rgba(232,54,93,.09);
        --gold: #c9a227;
        --gold-glow: rgba(201,162,39,.09);
        --green: #00b074;
        --green-glow: rgba(0,176,116,.09);
        --blue: #3b82f6;
        --blue-glow: rgba(59,130,246,.09);
        --purple: #8b5cf6;
        --purple-glow: rgba(139,92,246,.09);
        --tr: all .3s cubic-bezier(.4,0,.2,1);
    }

    * {
        box-sizing: border-box;
    }

    .cp-page {
        font-family: 'DM Sans',sans-serif;
        background: var(--surface-2);
        min-height: 100vh;
        padding: 28px 28px 56px;
    }

    .cp-hero {
        position: relative;
        overflow: hidden;
        background: var(--ink);
        border-radius: 22px;
        padding: 30px 40px;
        margin-bottom: 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
    }

        .cp-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 88% 50%,rgba(232,54,93,.16) 0%,transparent 50%),radial-gradient(circle at 12% 80%,rgba(201,162,39,.08) 0%,transparent 40%);
        }

        .cp-hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
            background-size: 44px 44px;
        }

    .cp-hero-l {
        position: relative;
        z-index: 1;
    }

    .cp-hero-tag {
        font-size: 11px;
        font-weight: 700;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 5px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .cp-hero-tag::before {
            content: '';
            width: 18px;
            height: 2px;
            background: var(--accent);
            border-radius: 1px;
        }

    .cp-hero-title {
        font-family: 'Playfair Display',serif;
        font-size: clamp(1.5rem,3vw,2.1rem);
        font-weight: 900;
        color: #fff;
        margin: 0 0 3px;
    }

        .cp-hero-title em {
            font-style: italic;
            color: var(--accent);
        }

    .cp-hero-sub {
        font-size: 13px;
        color: rgba(255,255,255,.45);
        margin: 0;
    }

    .cp-hero-r {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 100px;
        padding: 10px 20px;
        color: rgba(255,255,255,.8);
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: var(--tr);
    }

        .btn-back:hover {
            background: rgba(255,255,255,.14);
            color: #fff;
        }

    .btn-create {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 100px;
        padding: 12px 24px;
        font-family: 'DM Sans',sans-serif;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
        transition: var(--tr);
    }

        .btn-create:hover {
            background: var(--accent-dark);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 26px rgba(232,54,93,.3);
        }

    .stat-row {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .sc {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--surface-3);
        padding: 20px 18px;
        position: relative;
        overflow: hidden;
        transition: var(--tr);
    }

        .sc:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 36px rgba(0,0,0,.09);
            border-color: transparent;
        }

    .sc-bar {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        border-radius: 16px 16px 0 0;
    }

    .sc.c-blue .sc-bar {
        background: var(--blue);
    }

    .sc.c-green .sc-bar {
        background: var(--green);
    }

    .sc.c-gold .sc-bar {
        background: var(--gold);
    }

    .sc-ico {
        width: 40px;
        height: 40px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        margin-bottom: 12px;
    }

    .c-blue .sc-ico {
        background: var(--blue-glow);
        color: var(--blue);
    }

    .c-green .sc-ico {
        background: var(--green-glow);
        color: var(--green);
    }

    .c-gold .sc-ico {
        background: var(--gold-glow);
        color: var(--gold);
    }

    .sc-val {
        font-family: 'Playfair Display',serif;
        font-size: 1.9rem;
        font-weight: 900;
        color: var(--ink);
        line-height: 1;
        margin-bottom: 3px;
    }

    .sc-lbl {
        font-size: 10px;
        font-weight: 700;
        color: var(--ink-muted);
        text-transform: uppercase;
        letter-spacing: .8px;
    }

    .sbar {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--surface-3);
        padding: 14px 20px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .search-wrap {
        position: relative;
        flex: 1;
        min-width: 200px;
    }

        .search-wrap i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--ink-muted);
            font-size: 13px;
        }

    .search-inp {
        width: 100%;
        background: var(--surface-2);
        border: 1.5px solid var(--surface-3);
        border-radius: 10px;
        padding: 9px 13px 9px 35px;
        font-family: 'DM Sans',sans-serif;
        font-size: 13px;
        color: var(--ink);
        outline: none;
        transition: var(--tr);
    }

        .search-inp:focus {
            border-color: var(--accent);
            background: #fff;
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

    .filter-sel {
        background: var(--surface-2);
        border: 1.5px solid var(--surface-3);
        border-radius: 10px;
        padding: 9px 13px;
        font-family: 'DM Sans',sans-serif;
        font-size: 13px;
        color: var(--ink);
        outline: none;
        transition: var(--tr);
        cursor: pointer;
    }

        .filter-sel:focus {
            border-color: var(--accent);
        }

    .sbar-count {
        font-size: 12px;
        font-weight: 700;
        color: var(--ink-muted);
        white-space: nowrap;
    }

        .sbar-count span {
            color: var(--accent);
        }

    .add-card {
        background: #fff;
        border-radius: 18px;
        border: 2px dashed var(--surface-3);
        padding: 26px 24px;
        margin-bottom: 20px;
        transition: var(--tr);
    }

        .add-card:hover {
            border-color: var(--accent);
        }

    .add-title {
        font-family: 'Playfair Display',serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .add-title-ico {
        width: 28px;
        height: 28px;
        background: var(--accent-glow);
        color: var(--accent);
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
    }

    .add-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr 140px auto;
        gap: 10px;
        align-items: end;
    }

    .fg {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .fl {
        font-size: 10px;
        font-weight: 800;
        color: var(--ink);
        text-transform: uppercase;
        letter-spacing: .6px;
    }

    .fi {
        background: var(--surface-2);
        border: 1.5px solid var(--surface-3);
        border-radius: 8px;
        padding: 10px 13px;
        font-family: 'DM Sans',sans-serif;
        font-size: 13px;
        color: var(--ink);
        outline: none;
        transition: var(--tr);
        width: 100%;
    }

        .fi:focus {
            border-color: var(--accent);
            background: #fff;
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

    .toggle-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 13px;
        background: var(--surface-2);
        border-radius: 8px;
        border: 1.5px solid var(--surface-3);
    }

        .toggle-row .form-check-input[role=switch] {
            width: 2.4rem;
            height: 1.2rem;
            cursor: pointer;
        }

        .toggle-row .form-check-input:checked {
            background-color: var(--green);
            border-color: var(--green);
        }

    .toggle-lbl {
        font-size: 12px;
        font-weight: 700;
        color: var(--ink);
    }

    .btn-save {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 100px;
        padding: 11px 22px;
        font-family: 'DM Sans',sans-serif;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        transition: var(--tr);
        white-space: nowrap;
    }

        .btn-save:hover {
            background: var(--accent-dark);
            transform: translateY(-1px);
        }

    .cat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(272px,1fr));
        gap: 18px;
    }

    .cat-card {
        background: #fff;
        border-radius: 18px;
        border: 1px solid var(--surface-3);
        overflow: hidden;
        transition: var(--tr);
        display: flex;
        flex-direction: column;
    }

        .cat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 44px rgba(0,0,0,.11);
            border-color: transparent;
        }

    .cat-card-top {
        height: 6px;
    }

    .cat-card-body {
        padding: 22px 22px 18px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .cat-icon-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .cat-ico {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .cat-status-on {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 100px;
        font-size: 10px;
        font-weight: 700;
        background: var(--green-glow);
        color: var(--green);
    }

    .cat-status-off {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 100px;
        font-size: 10px;
        font-weight: 700;
        background: var(--surface-3);
        color: var(--ink-muted);
    }

    .cat-name {
        font-family: 'Playfair Display',serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--ink);
        margin: 0 0 6px;
    }

    .cat-desc {
        font-size: 12px;
        color: var(--ink-muted);
        line-height: 1.55;
        flex: 1;
        margin-bottom: 16px;
    }

    .cat-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 14px;
        border-top: 1px solid var(--surface-3);
    }

    .cat-id {
        font-size: 11px;
        font-weight: 700;
        color: var(--ink-muted);
    }

    .act-edit {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        text-decoration: none;
        transition: var(--tr);
        background: var(--gold-glow);
        color: var(--gold);
    }

        .act-edit:hover {
            background: var(--gold);
            color: #fff;
        }

    .empty-box {
        background: #fff;
        border-radius: 18px;
        border: 1px solid var(--surface-3);
        padding: 64px 24px;
        text-align: center;
    }

    .empty-ico {
        font-size: 3rem;
        color: var(--surface-3);
        margin-bottom: 14px;
    }

    .empty-title {
        font-family: 'Playfair Display',serif;
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 6px;
    }

    .empty-sub {
        font-size: 13px;
        color: var(--ink-muted);
        margin-bottom: 22px;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .cp-hero {
        animation: fadeUp .4s ease-out both;
    }

    .stat-row {
        animation: fadeUp .4s ease-out .07s both;
    }

    .add-card {
        animation: fadeUp .4s ease-out .1s both;
    }

    .sbar {
        animation: fadeUp .4s ease-out .12s both;
    }

    .cat-grid {
        animation: fadeUp .4s ease-out .16s both;
    }

    @@media(max-width:900px) {
        .stat-row {
            grid-template-columns: 1fr 1fr;
        }

        .add-form-row {
            grid-template-columns: 1fr 1fr;
        }

        .cp-page {
            padding: 14px;
        }
    }

    @@media(max-width:600px) {
        .stat-row {
            grid-template-columns: 1fr 1fr;
        }

        .add-form-row {
            grid-template-columns: 1fr;
        }

        .cp-hero {
            padding: 22px 18px;
        }
    }
</style>

<div class="cp-page">

    <!-- HERO -->
    <div class="cp-hero">
        <div class="cp-hero-l">
            <div class="cp-hero-tag"><i class="fas fa-list"></i> Admin Panel</div>
            <h1 class="cp-hero-title">Manage <em>Categories</em></h1>
            <p class="cp-hero-sub">@total categor@(total == 1 ? "y" : "ies") organising your catalog</p>
        </div>
        <div class="cp-hero-r">
            <a asp-action="Index" class="btn-back"><i class="fas fa-th-large"></i> Dashboard</a>
            <a asp-action="CreateCategory" class="btn-create"><i class="fas fa-plus"></i> Add Category</a>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="stat-row">
        <div class="sc c-blue"><div class="sc-bar"></div><div class="sc-ico"><i class="fas fa-list"></i></div><div class="sc-val">@total</div><div class="sc-lbl">Total Categories</div></div>
        <div class="sc c-green"><div class="sc-bar"></div><div class="sc-ico"><i class="fas fa-check-circle"></i></div><div class="sc-val">@active</div><div class="sc-lbl">Active</div></div>
        <div class="sc c-gold"><div class="sc-bar"></div><div class="sc-ico"><i class="fas fa-ban"></i></div><div class="sc-val">@inactive</div><div class="sc-lbl">Inactive</div></div>
    </div>

    <!-- QUICK ADD FORM -->
    <div class="add-card">
        <div class="add-title">
            <div class="add-title-ico"><i class="fas fa-plus"></i></div>
            Quick Add Category
        </div>
        <form asp-action="CreateCategory" method="post">
            @Html.AntiForgeryToken()
            <div class="add-form-row">
                <div class="fg">
                    <label class="fl">Category Name *</label>
                    <input type="text" name="Name" class="fi" placeholder="e.g. Electronics, Clothing..." required />
                </div>
                <div class="fg">
                    <label class="fl">Description</label>
                    <input type="text" name="Description" class="fi" placeholder="Short description (optional)" />
                </div>
                <div class="fg">
                    <label class="fl">Status</label>
                    <div class="toggle-row">
                        <input type="checkbox" name="IsActive" class="form-check-input" role="switch" id="isActiveToggle" value="true" checked />
                        <label class="toggle-lbl" for="isActiveToggle">Active</label>
                    </div>
                </div>
                <button type="submit" class="btn-save"><i class="fas fa-save"></i> Save</button>
            </div>
        </form>
    </div>

    <!-- SEARCH BAR -->
    <div class="sbar">
        <div class="search-wrap">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInp" class="search-inp" placeholder="Search categories..." />
        </div>
        <select id="statusFilter" class="filter-sel">
            <option value="">All Status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
        <div class="sbar-count">Showing <span id="catCount">@total</span> categories</div>
    </div>

    <!-- CATEGORIES GRID -->
    @if (Model != null && Model.Any())
    {
        <div class="cat-grid" id="catGrid">
            @foreach (var cat in Model)
            {
                string tc = topColors[ci % topColors.Length];
                string bg = bgColors[ci % bgColors.Length];
                string catIcon = catIcons[ci % catIcons.Length];
                string catSt = cat.IsActive ? "active" : "inactive";
                ci++;

                <div class="cat-card" data-name="@cat.Name?.ToLower()" data-status="@catSt">
                    <div class="cat-card-top" style="background:@tc;"></div>
                    <div class="cat-card-body">
                        <div class="cat-icon-row">
                            <div class="cat-ico" style="background:@bg;color:@tc;">
                                <i class="fas @catIcon"></i>
                            </div>
                            @if (cat.IsActive)
                            {
                                <span class="cat-status-on"><i class="fas fa-circle" style="font-size:6px;"></i> Active</span>
                            }
                            else
                            {
                                <span class="cat-status-off"><i class="fas fa-circle" style="font-size:6px;"></i> Inactive</span>
                            }
                        </div>
                        <div class="cat-name">@cat.Name</div>
                        <div class="cat-desc">
                            @(string.IsNullOrEmpty(cat.Description) ? "No description provided." : cat.Description)
                        </div>
                        <div class="cat-footer">
                            <span class="cat-id">ID #@cat.CategoryId</span>
                            <a asp-action="EditCategory" asp-route-id="@cat.CategoryId" class="act-edit" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-box">
            <div class="empty-ico"><i class="fas fa-layer-group"></i></div>
            <div class="empty-title">No Categories Yet</div>
            <div class="empty-sub">Use the quick-add form above to create your first category.</div>
        </div>
    }

</div>

@section Scripts {
    <script>
        function filterCats(){
            const q  = document.getElementById('searchInp').value.toLowerCase();
            const st = document.getElementById('statusFilter').value;
            const cards = document.querySelectorAll('#catGrid .cat-card');
            let visible = 0;
            cards.forEach(c => {
                const name = c.dataset.name   || '';
                const rSt  = c.dataset.status || '';
                const match = (!q  || name.includes(q))
                           && (!st || rSt === st);
                c.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            document.getElementById('catCount').textContent = visible;
        }
        document.getElementById('searchInp').addEventListener('input', filterCats);
        document.getElementById('statusFilter').addEventListener('change', filterCats);
    </script>
}
