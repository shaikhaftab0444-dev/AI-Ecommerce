<!-- ===== CATEGORY STRIP ===== -->
@{
    var dynCats = ViewBag.HomeCategories as List<BrandsStore.Models.Category>;
}
<div class="cat-strip">
    <div class="container">
        <div class="section-tag">Shop by Category</div>
        <h2 class="section-title-xl">Find What You <em>Love</em></h2>
        <p class="section-sub">Explore our wide range of categories curated just for you</p>
        <div class="cat-grid">
            @if (dynCats != null && dynCats.Any())
            {
                string[] labels = { "Top Picks", "New Season", "Trending", "Must Haves", "Active Life", "Shop Now", "Explore", "Discover" };
                int ci = 0;
                foreach (var cat in dynCats)
                {
                    // Map category name to exact image file in /images/categoryimages/
                    string catNameLower = cat.Name.ToLower().Trim();
                    string bg;
                    if (catNameLower.Contains("electron") || catNameLower.Contains("gadget") || catNameLower.Contains("tech"))
                        bg = "/images/categoryimages/electronics&gadgets.jpg";
                    else if (catNameLower.Contains("book"))
                        bg = "/images/categoryimages/books.jpg";
                    else if (catNameLower.Contains("home") || catNameLower.Contains("kitchen"))
                        bg = "/images/categoryimages/home&kitchen.jpg";
                    else if (catNameLower.Contains("sport") || catNameLower.Contains("fitness") || catNameLower.Contains("gym"))
                        bg = "/images/categoryimages/sports&fitness.jpg";
                    else if (catNameLower.Contains("shoe") || catNameLower.Contains("footwear") || catNameLower.Contains("sneaker"))
                        bg = "/images/categoryimages/shoes.jpg";
                    else if (catNameLower.Contains("shirt") || catNameLower.Contains("formal") || catNameLower.Contains("tshirt") || catNameLower.Contains("t-shirt") || catNameLower.Contains("top"))
                        bg = "/images/categoryimages/shirt.jpg";
                    else if (catNameLower.Contains("pant") || catNameLower.Contains("trouser") || catNameLower.Contains("jeans") || catNameLower.Contains("denim") || catNameLower.Contains("bottom"))
                        bg = "/images/categoryimages/pants.jpg";
                    else if (catNameLower.Contains("cloth") || catNameLower.Contains("fashion") || catNameLower.Contains("apparel") || catNameLower.Contains("wear") || catNameLower.Contains("dress") || catNameLower.Contains("kurti") || catNameLower.Contains("saree"))
                        bg = "/images/categoryimages/clothing.jpg";
                    else if (catNameLower.Contains("accessor") || catNameLower.Contains("jewel") || catNameLower.Contains("watch") || catNameLower.Contains("bag") || catNameLower.Contains("belt") || catNameLower.Contains("wallet") || catNameLower.Contains("necklace") || catNameLower.Contains("chain"))
                        bg = "/images/categoryimages/accessories.jpg";
                    else
                        bg = "/images/categoryimages/mix.jpg";

                    string lbl = ci < labels.Length ? labels[ci] : "Shop Now";
                    <a asp-controller="Home" asp-action="Products" asp-route-categoryId="@cat.CategoryId" class="cat-card">
                        <div class="cat-card-bg" style="background-image:url('@bg');"></div>
                        <div class="cat-card-content"><div class="cat-card-label">@lbl</div><div class="cat-card-name">@cat.Name</div><div class="cat-arrow"><i class="fas fa-arrow-right"></i></div></div>
                    </a>
                    ci++;
                }
            }
            else
            {
                <a asp-controller="Home" asp-action="Products" asp-route-categoryId="1" class="cat-card"><div class="cat-card-bg" style="background-image:url('/images/categoryimages/electronics&gadgets.jpg');"></div><div class="cat-card-content"><div class="cat-card-label">Top Picks</div><div class="cat-card-name">Electronics &amp; Gadgets</div><div class="cat-arrow"><i class="fas fa-arrow-right"></i></div></div></a>
                <a asp-controller="Home" asp-action="Products" asp-route-categoryId="2" class="cat-card"><div class="cat-card-bg" style="background-image:url('/images/products/sh.jpg');"></div><div class="cat-card-content"><div class="cat-card-label">New Season</div><div class="cat-card-name">Clothing</div><div class="cat-arrow"><i class="fas fa-arrow-right"></i></div></div></a>
                <a asp-controller="Home" asp-action="Products" asp-route-categoryId="3" class="cat-card"><div class="cat-card-bg" style="background-image:url('/images/categoryimages/books.jpg');"></div><div class="cat-card-content"><div class="cat-card-label">Trending</div><div class="cat-card-name">Books</div><div class="cat-arrow"><i class="fas fa-arrow-right"></i></div></div></a>
                <a asp-controller="Home" asp-action="Products" asp-route-categoryId="4" class="cat-card"><div class="cat-card-bg" style="background-image:url('/images/categoryimages/home&kitchen.jpg');"></div><div class="cat-card-content"><div class="cat-card-label">Must Haves</div><div class="cat-card-name">Home &amp; Kitchen</div><div class="cat-arrow"><i class="fas fa-arrow-right"></i></div></div></a>
                <a asp-controller="Home" asp-action="Products" asp-route-categoryId="9" class="cat-card"><div class="cat-card-bg" style="background-image:url('/images/categoryimages/sports&fitness.jpg');"></div><div class="cat-card-content"><div class="cat-card-label">Active Life</div><div class="cat-card-name">Sports &amp; Fitness</div><div class="cat-arrow"><i class="fas fa-arrow-right"></i></div></div></a>
                <a asp-controller="Home" asp-action="Products" asp-route-categoryId="5" class="cat-card"><div class="cat-card-bg" style="background-image:url('/images/categoryimages/shoes.jpg');"></div><div class="cat-card-content"><div class="cat-card-label">Active Life</div><div class="cat-card-name">Shoes</div><div class="cat-arrow"><i class="fas fa-arrow-right"></i></div></div></a>
            }
        </div>
    </div>
</div>

<!-- ===== NEW ARRIVALS ===== -->
@if (ViewBag.NewArrivals != null && ((List<BrandsStore.Models.Product>)ViewBag.NewArrivals).Any())
{
    <div class="products-section" style="background:var(--surface-2);">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-1">
                <div><div class="section-tag">Fresh In</div><h2 class="section-title-xl">New <em>Arrivals</em></h2></div>
                <a asp-controller="Home" asp-action="Products" class="btn-hero-ghost" style="color:var(--ink);border-color:var(--surface-3);background:white;font-size:13px;padding:10px 22px;">View All <i class="fas fa-arrow-right" style="font-size:11px;"></i></a>
            </div>
            <p class="section-sub">The latest drops — be the first to own them</p>
            <div class="prod-grid">
                @foreach (var product in (List<BrandsStore.Models.Product>)ViewBag.NewArrivals)
                {
