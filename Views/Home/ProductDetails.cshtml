@model BrandsStore.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500;600&display=swap');

    :root {
        --ink: #0a0a0f;
        --ink-soft: #3a3a4a;
        --ink-muted: #7a7a8c;
        --surface: #ffffff;
        --surface-2: #f5f5f8;
        --surface-3: #e8e8ef;
        --accent: #e8365d;
        --accent-dark: #c42548;
        --accent-glow: rgba(232, 54, 93, 0.1);
        --gold: #c9a227;
        --green: #00b074;
        --radius-sm: 8px;
        --radius-md: 16px;
        --radius-lg: 24px;
        --shadow-sm: 0 2px 12px rgba(0,0,0,0.06);
        --shadow-md: 0 8px 32px rgba(0,0,0,0.1);
        --shadow-lg: 0 24px 64px rgba(0,0,0,0.14);
        --transition: all 0.32s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .detail-hero {
        background: var(--ink);
        padding: 28px 0;
        position: relative;
        overflow: hidden;
    }

        .detail-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle at 80% 50%, rgba(232,54,93,0.1) 0%, transparent 50%), linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
            background-size: auto, 48px 48px, 48px 48px;
        }

    .crumb-row {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: rgba(255,255,255,0.35);
        font-weight: 500;
        flex-wrap: wrap;
    }

        .crumb-row a {
            color: rgba(255,255,255,0.35);
            text-decoration: none;
            transition: var(--transition);
        }

            .crumb-row a:hover {
                color: rgba(255,255,255,0.8);
            }

        .crumb-row i {
            font-size: 8px;
        }

        .crumb-row .crumb-current {
            color: rgba(255,255,255,0.75);
            font-weight: 600;
        }

    .detail-wrap {
        background: var(--surface-2);
        padding: 40px 0 80px;
    }

    .detail-card {
        background: white;
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-md);
        margin-bottom: 32px;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
    }

    /* IMAGE PANEL */
    .img-panel {
        background: var(--surface-2);
        padding: 40px;
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 16px;
        border-right: 1px solid var(--surface-3);
    }

    .main-img-frame {
        position: relative;
        border-radius: var(--radius-md);
        overflow: hidden;
        background: white;
        aspect-ratio: 1 / 1.05;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--surface-3);
    }

        .main-img-frame img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            transition: transform 0.6s cubic-bezier(0.4,0,0.2,1);
            padding: 20px;
        }

        .main-img-frame:hover img {
            transform: scale(1.06);
        }

    .img-no-product {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        min-height: 340px;
        color: var(--ink-muted);
        gap: 10px;
        font-size: 13px;
    }

        .img-no-product i {
            font-size: 3rem;
            opacity: 0.25;
        }

    .wishlist-fab {
        position: absolute;
        top: 52px;
        right: 52px;
        width: 44px;
        height: 44px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1.5px solid var(--surface-3);
        box-shadow: var(--shadow-sm);
        cursor: pointer;
        transition: var(--transition);
        z-index: 5;
        color: var(--ink-muted);
        font-size: 16px;
        text-decoration: none;
    }

        .wishlist-fab:hover {
            background: #fff0f3;
            border-color: var(--accent);
            color: var(--accent);
            transform: scale(1.1);
        }

    .thumb-row {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding-bottom: 4px;
        scrollbar-width: none;
    }

        .thumb-row::-webkit-scrollbar {
            display: none;
        }

    .thumb-item {
        flex-shrink: 0;
        width: 72px;
        height: 72px;
        border-radius: var(--radius-sm);
        overflow: hidden;
        background: white;
        border: 2px solid var(--surface-3);
        cursor: pointer;
        transition: var(--transition);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .thumb-item img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 6px;
        }

        .thumb-item:hover {
            border-color: var(--accent);
        }

        .thumb-item.active {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

    .thumb-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--ink-muted);
        font-size: 1.3rem;
        opacity: 0.35;
    }

    .delivery-strip {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 4px;
    }

    .delivery-chip {
        display: flex;
        align-items: center;
        gap: 7px;
        background: white;
        border: 1px solid var(--surface-3);
        border-radius: var(--radius-sm);
        padding: 9px 14px;
        font-size: 12px;
        font-weight: 600;
        color: var(--ink-soft);
        flex: 1;
        min-width: 130px;
    }

        .delivery-chip i {
            font-size: 13px;
        }

        .delivery-chip.green i {
            color: var(--green);
        }

        .delivery-chip.blue i {
            color: #4facfe;
        }

        .delivery-chip.gold i {
            color: var(--gold);
        }

    /* INFO PANEL */
    .info-panel {
        padding: 40px;
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .meta-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .meta-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 14px;
        border-radius: 100px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

        .meta-chip.cat {
            background: rgba(232,54,93,0.08);
            color: var(--accent);
            border: 1px solid rgba(232,54,93,0.2);
        }

        .meta-chip.in-stock {
            background: rgba(0,176,116,0.08);
            color: var(--green);
            border: 1px solid rgba(0,176,116,0.2);
        }

        .meta-chip.out-stock {
            background: rgba(156,163,175,0.1);
            color: #6b7280;
            border: 1px solid #e5e7eb;
        }

        .meta-chip .pulse-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
            animation: pulseDot 1.8s ease-in-out infinite;
        }

    @@keyframes pulseDot {
        0%, 100% {
            opacity: 1;
            transform: scale(1)
        }

        50% {
            opacity: 0.5;
            transform: scale(0.8)
        }
    }

    .product-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.6rem, 2.5vw, 2.2rem);
        font-weight: 900;
        color: var(--ink);
        line-height: 1.2;
        margin-bottom: 16px;
        letter-spacing: -0.02em;
    }

    .stars-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 24px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--surface-3);
    }

        .stars-row .stars {
            display: flex;
            gap: 2px;
        }

            .stars-row .stars i {
                color: #f5a623;
                font-size: 14px;
            }

        .stars-row .rating-val {
            font-size: 14px;
            font-weight: 700;
            color: var(--ink);
        }

        .stars-row .review-link {
            font-size: 13px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 500;
        }

            .stars-row .review-link:hover {
                text-decoration: underline;
            }

    .price-block {
        margin-bottom: 24px;
    }

    .price-main {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2rem, 3vw, 2.8rem);
        font-weight: 900;
        color: var(--ink);
        line-height: 1;
        margin-bottom: 4px;
    }

        .price-main sup {
            font-size: 0.55em;
            vertical-align: super;
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
        }

    .price-note {
        font-size: 12px;
        color: var(--ink-muted);
        font-weight: 500;
    }

    .desc-block {
        background: var(--surface-2);
        border-radius: var(--radius-md);
        padding: 20px;
        margin-bottom: 24px;
        border-left: 3px solid var(--accent);
    }

    .desc-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 8px;
    }

    .desc-text {
        font-size: 14px;
        color: var(--ink-soft);
        line-height: 1.75;
        margin: 0;
    }

    .selector-block {
        margin-bottom: 20px;
    }

    .selector-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .selector-label .selected-val {
            font-weight: 500;
            color: var(--ink-muted);
            margin-left: 4px;
        }

    .size-options, .color-options {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .size-chip {
        min-width: 48px;
        height: 44px;
        padding: 0 14px;
        background: white;
        border: 1.5px solid var(--surface-3);
        border-radius: var(--radius-sm);
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
        color: var(--ink);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--transition);
        font-family: 'DM Sans', sans-serif;
    }

        .size-chip:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        .size-chip.active {
            background: var(--ink);
            border-color: var(--ink);
            color: white;
            box-shadow: 0 4px 14px rgba(10,10,15,0.2);
        }

    .color-dot {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 2.5px solid white;
        outline: 2px solid var(--surface-3);
        cursor: pointer;
        transition: var(--transition);
    }

        .color-dot:hover {
            outline-color: var(--accent);
            transform: scale(1.1);
        }

        .color-dot.active {
            outline-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-glow);
            transform: scale(1.1);
        }

    .qty-block {
        margin-bottom: 24px;
    }

    .qty-row {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .qty-btn {
        width: 40px;
        height: 40px;
        background: var(--surface-2);
        border: 1.5px solid var(--surface-3);
        border-radius: var(--radius-sm);
        font-size: 18px;
        font-weight: 700;
        color: var(--ink);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--transition);
        line-height: 1;
        font-family: 'DM Sans', sans-serif;
    }

        .qty-btn:hover {
            background: var(--ink);
            color: white;
            border-color: var(--ink);
        }

    .qty-val {
        width: 60px;
        height: 40px;
        border: 1.5px solid var(--surface-3);
        border-radius: var(--radius-sm);
        text-align: center;
        font-size: 15px;
        font-weight: 700;
        color: var(--ink);
        background: white;
        font-family: 'DM Sans', sans-serif;
        outline: none;
    }

        .qty-val:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

    .stock-tag {
        font-size: 12px;
        font-weight: 600;
        color: var(--green);
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .stock-tag i {
            font-size: 11px;
        }

        .stock-tag.low {
            color: var(--gold);
        }

        .stock-tag.none {
            color: #9ca3af;
        }

    .actions-block {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 24px;
    }

    .btn-buy-now {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 16px 24px;
        background: var(--accent);
        color: white;
        border: none;
        border-radius: var(--radius-md);
        font-family: 'DM Sans', sans-serif;
        font-size: 15px;
        font-weight: 800;
        cursor: pointer;
        transition: var(--transition);
        text-decoration: none;
        letter-spacing: 0.3px;
    }

        .btn-buy-now:hover {
            background: var(--accent-dark);
            transform: translateY(-3px);
            box-shadow: 0 12px 36px rgba(232,54,93,0.3);
            color: white;
        }

        .btn-buy-now:disabled {
            background: var(--surface-3);
            color: var(--ink-muted);
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    .btn-cart-add {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 15px 24px;
        background: white;
        color: var(--ink);
        border: 1.5px solid var(--surface-3);
        border-radius: var(--radius-md);
        font-family: 'DM Sans', sans-serif;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: var(--transition);
        text-decoration: none;
    }

        .btn-cart-add:hover {
            background: var(--ink);
            color: white;
            border-color: var(--ink);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(10,10,15,0.2);
        }

        .btn-cart-add:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

    .btn-wishlist-add {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 13px 24px;
        background: transparent;
        color: var(--ink-muted);
        border: 1.5px solid var(--surface-3);
        border-radius: var(--radius-md);
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition);
    }

        .btn-wishlist-add:hover {
            border-color: var(--accent);
            color: var(--accent);
            background: var(--accent-glow);
        }

    .oos-notice {
        background: #fff8f9;
        border: 1.5px solid rgba(232,54,93,0.2);
        border-radius: var(--radius-md);
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        color: var(--accent);
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 24px;
    }

        .oos-notice i {
            font-size: 20px;
        }

    /* REVIEWS */
    .reviews-card {
        background: white;
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-md);
    }

    .reviews-head {
        padding: 32px 40px 24px;
        border-bottom: 1px solid var(--surface-3);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

    .reviews-head-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--ink);
        margin: 0;
    }

    .reviews-count-pill {
        background: var(--surface-2);
        border-radius: 100px;
        padding: 6px 16px;
        font-size: 13px;
        font-weight: 600;
        color: var(--ink-muted);
    }

    .rating-stats-row {
        padding: 32px 40px;
        display: flex;
        gap: 48px;
        border-bottom: 1px solid var(--surface-3);
        flex-wrap: wrap;
    }

    .big-score {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 120px;
        gap: 6px;
    }

    .big-score-num {
        font-family: 'Playfair Display', serif;
        font-size: 4rem;
        font-weight: 900;
        color: var(--ink);
        line-height: 1;
    }

    .big-score-stars {
        display: flex;
        gap: 3px;
    }

        .big-score-stars i {
            color: #f5a623;
            font-size: 15px;
        }

    .big-score-label {
        font-size: 12px;
        color: var(--ink-muted);
        font-weight: 500;
    }

    .bars-col {
        flex: 1;
        min-width: 220px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
    }

    .bar-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .bar-num {
        font-size: 12px;
        font-weight: 700;
        color: var(--ink-muted);
        min-width: 45px;
    }

    .bar-track {
        flex: 1;
        height: 6px;
        background: var(--surface-3);
        border-radius: 3px;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        background: #f5a623;
        border-radius: 3px;
    }

    .bar-count {
        font-size: 12px;
        color: var(--ink-muted);
        min-width: 28px;
        text-align: right;
    }

    .reviews-list {
        padding: 0 40px 40px;
        display: flex;
        flex-direction: column;
    }

    .review-item {
        padding: 28px 0;
        border-bottom: 1px solid var(--surface-3);
        transition: var(--transition);
    }

        .review-item:last-child {
            border-bottom: none;
        }

        .review-item:hover {
            padding-left: 6px;
        }

    .review-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 12px;
        gap: 12px;
    }

    .reviewer {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .reviewer-av {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--ink);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Playfair Display', serif;
        font-size: 16px;
        font-weight: 700;
        flex-shrink: 0;
    }

        .reviewer-av.alt1 {
            background: #1a56f0;
        }

        .reviewer-av.alt2 {
            background: var(--gold);
        }

    .reviewer-name {
        font-size: 14px;
        font-weight: 700;
        color: var(--ink);
    }

    .reviewer-date {
        font-size: 12px;
        color: var(--ink-muted);
    }

    .review-stars {
        display: flex;
        gap: 2px;
    }

        .review-stars i {
            color: #f5a623;
            font-size: 13px;
        }

    .review-body {
        font-size: 14px;
        color: var(--ink-soft);
        line-height: 1.75;
        margin-bottom: 12px;
    }

    .verified-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(0,176,116,0.08);
        color: var(--green);
        border: 1px solid rgba(0,176,116,0.2);
        border-radius: 100px;
        padding: 4px 12px;
        font-size: 11px;
        font-weight: 700;
    }

        .verified-tag i {
            font-size: 10px;
        }

    @@media (max-width: 991px) {
        .detail-grid {
            grid-template-columns: 1fr;
        }

        .img-panel {
            border-right: none;
            border-bottom: 1px solid var(--surface-3);
            padding: 28px;
        }

        .info-panel {
            padding: 28px;
        }

        .wishlist-fab {
            top: 40px;
            right: 40px;
        }
    }

    @@media (max-width: 767px) {
        .rating-stats-row {
            gap: 28px;
            padding: 24px;
        }

        .reviews-head {
            padding: 24px;
        }

        .reviews-list {
            padding: 0 24px 24px;
        }

        .delivery-chip {
            min-width: 120px;
            font-size: 11px;
        }
    }

    @@media (max-width: 575px) {
        .detail-wrap {
            padding: 20px 0 60px;
        }

        .img-panel, .info-panel {
            padding: 20px;
        }

        .big-score-num {
            font-size: 3rem;
        }

        .reviews-head, .reviews-list {
            padding: 20px;
        }

        .rating-stats-row {
            padding: 20px;
            flex-direction: column;
            gap: 20px;
        }
    }
</style>

<!-- BREADCRUMB HERO -->
<div class="detail-hero">
    <div class="container">
        <div class="crumb-row">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i></a>
            <i class="fas fa-chevron-right"></i>
            <a asp-controller="Home" asp-action="Products">Products</a>
            <i class="fas fa-chevron-right"></i>
            <a asp-controller="Home" asp-action="Products" asp-route-categoryId="@Model.CategoryId">@Model.Category.Name</a>
            <i class="fas fa-chevron-right"></i>
            <span class="crumb-current">@Model.Name</span>
        </div>
    </div>
</div>

<div class="detail-wrap">
    <div class="container">
        <div class="detail-card">
            <div class="detail-grid">

                <!-- LEFT: Image Panel -->
                <div class="img-panel">
                    <div class="main-img-frame">
                        @if (User.IsInRole("User"))
                        {
                            <form asp-controller="Wishlist" asp-action="AddToWishlist" method="post" class="m-0">
                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                <button type="submit" class="wishlist-fab" title="Add to Wishlist">
                                    <i class="fas fa-heart"></i>
                                </button>
                            </form>
                        }
                        else if (!User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Account" asp-action="Login" class="wishlist-fab" title="Login to wishlist">
                                <i class="far fa-heart"></i>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img id="mainImage" src="@Model.ImageUrl" alt="@Model.Name">
                        }
                        else
                        {
                            <div class="img-no-product">
                                <i class="fas fa-image"></i>
                                <span>@Model.Name</span>
                            </div>
                        }
                    </div>
                    <div class="thumb-row">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            for (int i = 0; i < 4; i++)
                            {
                                <div class="thumb-item @(i == 0 ? "active" : "")" onclick="changeImg(this, '@Model.ImageUrl')">
                                    <img src="@Model.ImageUrl" alt="View @(i + 1)">
                                </div>
                            }
                        }
                        else
                        {
                            for (int i = 0; i < 4; i++)
                            {
                                <div class="thumb-item @(i == 0 ? "active" : "")">
                                    <div class="thumb-placeholder"><i class="fas fa-image"></i></div>
                                </div>
                            }
                        }
                    </div>
                    <div class="delivery-strip">
                        <div class="delivery-chip green"><i class="fas fa-truck"></i> Free delivery over ₹999</div>
                        <div class="delivery-chip blue"><i class="fas fa-undo"></i> 30-day returns</div>
                        <div class="delivery-chip gold"><i class="fas fa-shield-alt"></i> Authentic product</div>
                    </div>
                </div>

                <!-- RIGHT: Info Panel -->
                <div class="info-panel">
                    <div class="meta-row">
                        <span class="meta-chip cat"><i class="fas fa-tag"></i> @Model.Category.Name</span>
                        @if (Model.StockQuantity > 0)
                        {
                            <span class="meta-chip in-stock"><span class="pulse-dot"></span> In Stock</span>
                        }
                        else
                        {

                            <span class="meta-chip out-stock"><i class="fas fa-times-circle"></i> Out of Stock</span>
                        }
                    </div>

                    <h1 class="product-title">@Model.Name</h1>

                    <div class="stars-row">
                        <div class="stars">
                            <i class="fas fa-star"></i><i class="fas fa-star"></i>
                            <i class="fas fa-star"></i><i class="fas fa-star"></i>
                            <i class="fas fa-star-half-alt"></i>
                        </div>
                        <span class="rating-val">4.5</span>
                        <a href="#reviews" class="review-link">128 reviews</a>
                    </div>

                    <div class="price-block">
                        <div class="price-main" id="displayPrice"><sup>₹</sup>@Model.Price.ToString("N0")</div>
                        <div class="price-note">Inclusive of all taxes &nbsp;·&nbsp; EMI available from ₹@((Model.Price / 12).ToString("N0"))/mo</div>
                    </div>

                    <div class="desc-block">
                        <div class="desc-label">About this product</div>
                        <p class="desc-text">
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                @Model.Description
                            }
                            else
                            {

                                <text>High-quality product crafted with premium materials. Designed to deliver exceptional performance and style for everyday use.</text>
                            }
                        </p>
                    </div>

                    <div class="selector-block" id="sizeSelector" style="display:none;">
                        <div class="selector-label">Size <span class="selected-val" id="selectedSizeLabel"></span></div>
                        <div class="size-options" id="dynamicSizeOptions"></div>
                    </div>

                    <div class="selector-block" id="colorSelector" style="display:none;">
                        <div class="selector-label">Color <span class="selected-val" id="selectedColorLabel"></span></div>
                        <div class="color-options" id="dynamicColorOptions"></div>
                    </div>

                    @if (Model.StockQuantity > 0)
                    {
                        <div class="qty-block">
                            <div class="selector-label">Quantity</div>
                            <div class="qty-row">
                                <button type="button" class="qty-btn" onclick="decreaseQty()">−</button>
                                <input type="number" id="quantityInput" value="1" min="1" max="@Model.StockQuantity" class="qty-val" readonly>
                                <button type="button" class="qty-btn" onclick="increaseQty()">+</button>
                                <span class="stock-tag @(Model.StockQuantity < 10 ? "low" : "")" id="stockTag">
                                    <i class="fas fa-box"></i>
                                    <span id="stockText">@Model.StockQuantity left</span>
                                </span>
                            </div>
                        </div>

                        <div class="actions-block">
                            @if (User.IsInRole("User"))
                            {
                                <!-- ✅ FIX: Buy Now posts to Cart/BuyNow (POST), NOT Cart/Checkout (GET) -->
                                <form asp-controller="Cart" asp-action="BuyNow" method="post" class="m-0">
                                    <input type="hidden" name="productId" value="@Model.ProductId" />
                                    <input type="hidden" name="sizeId" id="buyNowSizeInput" value="" />
                                    <input type="hidden" name="colorId" id="buyNowColorInput" value="" />
                                    <input type="hidden" name="quantity" id="buyNowQtyInput" value="1" />
                                    <button type="submit" class="btn-buy-now" id="buyNowBtn">
                                        <i class="fas fa-bolt"></i> Buy Now
                                    </button>
                                </form>
                                <!-- Add to Cart -->
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="m-0">
                                    <input type="hidden" name="productId" value="@Model.ProductId" />
                                    <input type="hidden" name="sizeId" id="cartSizeInput" value="" />
                                    <input type="hidden" name="colorId" id="cartColorInput" value="" />
                                    <input type="hidden" name="quantity" id="cartQtyInput" value="1" />
                                    <button type="submit" class="btn-cart-add" id="cartBtn">
                                        <i class="fas fa-bag-shopping"></i> Add to Cart
                                    </button>
                                </form>
                                <!-- Wishlist -->
                                <form asp-controller="Wishlist" asp-action="AddToWishlist" method="post" class="m-0">
                                    <input type="hidden" name="productId" value="@Model.ProductId" />
                                    <button type="submit" class="btn-wishlist-add">
                                        <i class="fas fa-heart"></i> Save to Wishlist
                                    </button>
                                </form>
                            }
                            else if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                            {
                                <a asp-controller="Admin" asp-action="EditProduct" asp-route-id="@Model.ProductId" class="btn-buy-now">
                                    <i class="fas fa-edit"></i> Edit Product (Admin)
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn-buy-now">
                                    <i class="fas fa-sign-in-alt"></i> Login to Purchase
                                </a>
                                <a asp-controller="Account" asp-action="Register" class="btn-cart-add">
                                    <i class="fas fa-user-plus"></i> Create Account
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="oos-notice">
                            <i class="fas fa-exclamation-circle"></i>
                            <div>
                                <strong>Out of Stock</strong><br>
                                <span style="font-weight:400; font-size:13px;">This item is currently unavailable. Check back soon.</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- REVIEWS -->
        <div class="reviews-card" id="reviews">
            <div class="reviews-head">
                <h2 class="reviews-head-title">Customer Reviews</h2>
                <span class="reviews-count-pill">128 reviews</span>
            </div>
            <div class="rating-stats-row">
                <div class="big-score">
                    <div class="big-score-num">4.5</div>
                    <div class="big-score-stars">
                        <i class="fas fa-star"></i><i class="fas fa-star"></i>
                        <i class="fas fa-star"></i><i class="fas fa-star"></i>
                        <i class="fas fa-star-half-alt"></i>
                    </div>
                    <div class="big-score-label">out of 5</div>
                </div>
                <div class="bars-col">
                    <div class="bar-row"><span class="bar-num">5 stars</span><div class="bar-track"><div class="bar-fill" style="width:75%"></div></div><span class="bar-count">96</span></div>
                    <div class="bar-row"><span class="bar-num">4 stars</span><div class="bar-track"><div class="bar-fill" style="width:15%"></div></div><span class="bar-count">19</span></div>
                    <div class="bar-row"><span class="bar-num">3 stars</span><div class="bar-track"><div class="bar-fill" style="width:5%"></div></div><span class="bar-count">6</span></div>
                    <div class="bar-row"><span class="bar-num">2 stars</span><div class="bar-track"><div class="bar-fill" style="width:3%"></div></div><span class="bar-count">4</span></div>
                    <div class="bar-row"><span class="bar-num">1 star</span><div class="bar-track"><div class="bar-fill" style="width:2%"></div></div><span class="bar-count">3</span></div>
                </div>
            </div>
            <div class="reviews-list">
                <div class="review-item">
                    <div class="review-top">
                        <div class="reviewer"><div class="reviewer-av">AK</div><div><div class="reviewer-name">Aman Kumar</div><div class="reviewer-date">January 5, 2026</div></div></div>
                        <div class="review-stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                    </div>
                    <p class="review-body">Excellent product! The quality is outstanding and it arrived exactly as described. Highly recommend to anyone looking for great value. Fast shipping and well packaged too.</p>
                    <span class="verified-tag"><i class="fas fa-check-circle"></i> Verified Purchase</span>
                </div>
                <div class="review-item">
                    <div class="review-top">
                        <div class="reviewer"><div class="reviewer-av alt1">PS</div><div><div class="reviewer-name">Priya Sharma</div><div class="reviewer-date">January 3, 2026</div></div></div>
                        <div class="review-stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="far fa-star"></i></div>
                    </div>
                    <p class="review-body">Good product overall. The quality is really nice but delivery took slightly longer than expected. Still very happy with my purchase and would buy again from this store.</p>
                    <span class="verified-tag"><i class="fas fa-check-circle"></i> Verified Purchase</span>
                </div>
                <div class="review-item">
                    <div class="review-top">
                        <div class="reviewer"><div class="reviewer-av alt2">RV</div><div><div class="reviewer-name">Rahul Verma</div><div class="reviewer-date">December 28, 2025</div></div></div>
                        <div class="review-stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                    </div>
                    <p class="review-body">Amazing quality and exceptional customer service! This exceeded my expectations completely. The attention to detail is impressive and it looks even better in person.</p>
                    <span class="verified-tag"><i class="fas fa-check-circle"></i> Verified Purchase</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedSize = null, selectedColor = null;
        let currentMaxStock = @Model.StockQuantity;
        const productId = @Model.ProductId;
        const basePrice = @Model.Price;

        function decreaseQty() {
            const inp = document.getElementById('quantityInput');
            if (+inp.value > 1) { inp.value = +inp.value - 1; syncQty(inp.value); }
        }
        function increaseQty() {
            const inp = document.getElementById('quantityInput');
            if (+inp.value < currentMaxStock) { inp.value = +inp.value + 1; syncQty(inp.value); }
        }
        function syncQty(v) {
            ['buyNowQtyInput','cartQtyInput'].forEach(id => { const el = document.getElementById(id); if (el) el.value = v; });
        }
        function changeImg(el, src) {
            document.getElementById('mainImage').src = src;
            document.querySelectorAll('.thumb-item').forEach(t => t.classList.remove('active'));
            el.classList.add('active');
        }
        function selectSize(el, sizeId, sizeName) {
            document.querySelectorAll('.size-chip').forEach(c => c.classList.remove('active'));
            el.classList.add('active'); selectedSize = sizeId;
            const lbl = document.getElementById('selectedSizeLabel'); if (lbl) lbl.textContent = '— ' + sizeName;
            syncSizeInputs(sizeId); checkVariant();
        }
        function syncSizeInputs(v) {
            ['buyNowSizeInput','cartSizeInput'].forEach(id => { const el = document.getElementById(id); if (el) el.value = v || ''; });
        }
        function selectColor(el, colorId, colorName) {
            document.querySelectorAll('.color-dot').forEach(c => c.classList.remove('active'));
            el.classList.add('active'); selectedColor = colorId;
            const lbl = document.getElementById('selectedColorLabel'); if (lbl) lbl.textContent = '— ' + colorName;
            syncColorInputs(colorId); checkVariant();
        }
        function syncColorInputs(v) {
            ['buyNowColorInput','cartColorInput'].forEach(id => { const el = document.getElementById(id); if (el) el.value = v || ''; });
        }
        async function loadVariants() {
            try {
                const res = await fetch(`/api/ProductVariantApi/GetProductVariants/${productId}`);
                const data = await res.json();
                const sizes = data.sizes || [], colors = data.colors || [];
                if (sizes.length > 0) {
                    document.getElementById('dynamicSizeOptions').innerHTML = sizes.map((s, i) =>
                        `<div class="size-chip ${i===0?'active':''}" onclick="selectSize(this,${s.sizeId},'${s.sizeName}')">${s.sizeName}</div>`
                    ).join('');
                    document.getElementById('sizeSelector').style.display = 'block';
                    if (sizes[0]) { selectedSize = sizes[0].sizeId; syncSizeInputs(selectedSize); }
                }
                if (colors.length > 0) {
                    document.getElementById('dynamicColorOptions').innerHTML = colors.map((c, i) =>
                        `<div class="color-dot ${i===0?'active':''}" style="background:${c.colorCode}" title="${c.colorName}"
                             onclick="selectColor(this,${c.colorId},'${c.colorName}')"></div>`
                    ).join('');
                    document.getElementById('colorSelector').style.display = 'block';
                    if (colors[0]) { selectedColor = colors[0].colorId; syncColorInputs(selectedColor); }
                }
                if (sizes.length > 0 || colors.length > 0) checkVariant();
            } catch(e) { console.error('Variants error:', e); }
        }
        async function checkVariant() {
            if (!selectedSize && !selectedColor) return;
            try {
                const res = await fetch(`/api/ProductVariantApi/GetVariantStock/${productId}/${selectedSize||0}/${selectedColor||0}`);
                const data = await res.json();
                const buyBtn = document.getElementById('buyNowBtn');
                const cartBtn = document.getElementById('cartBtn');
                const stockText = document.getElementById('stockText');
                const stockTag = document.getElementById('stockTag');
                const priceEl = document.getElementById('displayPrice');
                const qtyInput = document.getElementById('quantityInput');
                if (data.isAvailable && data.stockQuantity > 0) {
                    currentMaxStock = data.stockQuantity;
                    if (buyBtn) { buyBtn.disabled = false; buyBtn.style.opacity = '1'; }
                    if (cartBtn) { cartBtn.disabled = false; cartBtn.style.opacity = '1'; }
                    if (stockText) stockText.textContent = data.stockQuantity + ' left';
                    if (stockTag) stockTag.className = 'stock-tag' + (data.stockQuantity < 10 ? ' low' : '');
                    if (data.price > 0 && priceEl) priceEl.innerHTML = '<sup>₹</sup>' + Math.round(data.price).toLocaleString('en-IN');
                    if (qtyInput) { qtyInput.max = data.stockQuantity; if (+qtyInput.value > data.stockQuantity) { qtyInput.value = data.stockQuantity; syncQty(data.stockQuantity); } }
                } else {
                    currentMaxStock = 0;
                    if (buyBtn) { buyBtn.disabled = true; buyBtn.style.opacity = '0.4'; }
                    if (cartBtn) { cartBtn.disabled = true; cartBtn.style.opacity = '0.4'; }
                    if (stockText) stockText.textContent = 'Out of stock';
                    if (stockTag) stockTag.className = 'stock-tag none';
                }
            } catch(e) { console.error('Variant check error:', e); }
        }
        document.addEventListener('DOMContentLoaded', loadVariants);
    </script>
}
