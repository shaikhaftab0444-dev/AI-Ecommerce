@{
    ViewData["Title"] = "Quick Checkout";
    var product = ViewBag.Product as BrandsStore.Models.Product;
    int quantity = ViewBag.Quantity ?? 1;
    decimal price = ViewBag.Price ?? 0;
    decimal total = ViewBag.Total ?? 0;
    string variantInfo = ViewBag.VariantInfo ?? "";
    int? sizeId = ViewBag.SizeId as int?;
    int? colorId = ViewBag.ColorId as int?;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500;600&display=swap');

    :root {
        --ink: #0a0a0f;
        --ink-soft: #3a3a4a;
        --ink-muted: #7a7a8c;
        --surface: #ffffff;
        --surface-2: #f5f5f8;
        --surface-3: #e8e8ef;
        --accent: #e8365d;
        --accent-dark: #c42548;
        --accent-glow: rgba(232,54,93,0.1);
        --gold: #c9a227;
        --green: #00b074;
        --radius-sm: 8px;
        --radius-md: 16px;
        --radius-lg: 24px;
        --shadow-md: 0 8px 32px rgba(0,0,0,0.1);
        --transition: all 0.32s cubic-bezier(0.4,0,0.2,1);
    }

    .checkout-hero {
        background: var(--ink);
        padding: 36px 0;
        position: relative;
        overflow: hidden;
    }

        .checkout-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle at 85% 50%, rgba(232,54,93,0.12) 0%, transparent 50%), linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
            background-size: auto, 48px 48px, 48px 48px;
        }

    .hero-inner {
        position: relative;
        z-index: 1;
    }

    .crumb-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: rgba(255,255,255,0.35);
        font-weight: 500;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

        .crumb-row a {
            color: rgba(255,255,255,0.35);
            text-decoration: none;
        }

            .crumb-row a:hover {
                color: rgba(255,255,255,0.7);
            }

        .crumb-row i {
            font-size: 8px;
        }

    .crumb-current {
        color: rgba(255,255,255,0.75);
        font-weight: 600;
    }

    .checkout-hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.8rem, 3.5vw, 2.6rem);
        font-weight: 900;
        color: white;
        margin: 0 0 6px;
    }

        .checkout-hero h1 em {
            font-style: italic;
            color: var(--accent);
        }

    .checkout-hero-sub {
        color: rgba(255,255,255,0.45);
        font-size: 14px;
        margin: 0;
    }

    .checkout-steps {
        background: white;
        border-bottom: 1px solid var(--surface-3);
    }

    .steps-inner {
        display: flex;
        align-items: stretch;
        max-width: 600px;
    }

    .step-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 16px 24px;
        font-size: 13px;
        font-weight: 600;
        color: var(--ink-muted);
        position: relative;
        flex: 1;
    }

        .step-item::after {
            content: '';
            position: absolute;
            right: -1px;
            top: 0;
            bottom: 0;
            width: 1px;
            background: var(--surface-3);
        }

        .step-item:last-child::after {
            display: none;
        }

    .step-num {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--surface-2);
        border: 2px solid var(--surface-3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 800;
        color: var(--ink-muted);
        flex-shrink: 0;
    }

    .step-item.active .step-num {
        background: var(--accent);
        border-color: var(--accent);
        color: white;
    }

    .step-item.active {
        color: var(--ink);
    }

    .step-item.done .step-num {
        background: var(--green);
        border-color: var(--green);
        color: white;
    }

    .step-item.done {
        color: var(--green);
    }

    .checkout-wrap {
        background: var(--surface-2);
        padding: 36px 0 80px;
    }

    .form-card {
        background: white;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        overflow: hidden;
        margin-bottom: 16px;
    }

    .form-section-head {
        padding: 22px 32px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid var(--surface-3);
    }

    .form-section-num {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--accent);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 800;
        flex-shrink: 0;
    }

    .form-section-head h5 {
        font-family: 'Playfair Display', serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--ink);
        margin: 0;
    }

    .form-section-head .section-note {
        font-size: 12px;
        color: var(--ink-muted);
        margin-left: auto;
    }

    .form-body {
        padding: 28px 32px;
    }

    .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 16px;
    }

        .field-row.single {
            grid-template-columns: 1fr;
        }

    .field-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .field-label {
        font-size: 12px;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

        .field-label .req {
            color: var(--accent);
        }

    .field-input, .field-textarea {
        background: var(--surface-2);
        border: 1.5px solid var(--surface-3);
        border-radius: var(--radius-sm);
        padding: 12px 16px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        color: var(--ink);
        outline: none;
        transition: var(--transition);
        width: 100%;
    }

        .field-input:focus, .field-textarea:focus {
            border-color: var(--accent);
            background: white;
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

        .field-input[readonly] {
            background: var(--surface-3);
            color: var(--ink-muted);
            cursor: not-allowed;
        }

    .field-textarea {
        resize: vertical;
        min-height: 100px;
    }

    .info-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        background: rgba(26,86,240,0.05);
        border: 1px solid rgba(26,86,240,0.15);
        border-radius: var(--radius-md);
        padding: 14px 18px;
        margin-top: 16px;
        font-size: 13px;
        color: var(--ink-soft);
    }

        .info-banner i {
            color: #1a56f0;
            font-size: 16px;
            flex-shrink: 0;
        }

    .payment-options {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .payment-option {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 20px;
        border: 1.5px solid var(--surface-3);
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: var(--transition);
    }

        .payment-option:has(input:checked) {
            border-color: var(--accent);
            background: var(--accent-glow);
        }

        .payment-option.disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .payment-option input[type="radio"] {
            accent-color: var(--accent);
            width: 18px;
            height: 18px;
        }

    .pay-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

        .pay-icon.cod {
            background: rgba(0,176,116,0.1);
            color: var(--green);
        }

        .pay-icon.card {
            background: var(--surface-2);
            color: var(--ink-muted);
        }

    .pay-label strong {
        font-size: 14px;
        color: var(--ink);
        display: block;
    }

    .pay-label span {
        font-size: 12px;
        color: var(--ink-muted);
    }

    .coming-tag {
        background: var(--surface-2);
        color: var(--ink-muted);
        border-radius: 100px;
        padding: 3px 10px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .form-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        padding-top: 4px;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: white;
        color: var(--ink);
        border: 1.5px solid var(--surface-3);
        border-radius: 100px;
        padding: 12px 24px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: var(--transition);
    }

        .btn-back:hover {
            border-color: var(--ink);
            background: var(--ink);
            color: white;
        }

    .btn-place {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--accent);
        color: white;
        border: none;
        border-radius: 100px;
        padding: 14px 32px;
        font-family: 'DM Sans', sans-serif;
        font-size: 15px;
        font-weight: 800;
        cursor: pointer;
        transition: var(--transition);
    }

        .btn-place:hover {
            background: var(--accent-dark);
            transform: translateY(-3px);
            box-shadow: 0 12px 36px rgba(232,54,93,0.3);
            color: white;
        }

    .summary-card {
        background: white;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        overflow: hidden;
        position: sticky;
        top: 90px;
    }

    .summary-head {
        padding: 22px 28px;
        background: var(--ink);
        display: flex;
        align-items: center;
        gap: 10px;
        position: relative;
        overflow: hidden;
    }

        .summary-head::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 80% 50%, rgba(232,54,93,0.2) 0%, transparent 60%);
        }

        .summary-head h5 {
            font-family: 'Playfair Display', serif;
            font-size: 1.1rem;
            font-weight: 700;
            color: white;
            margin: 0;
            position: relative;
            z-index: 1;
        }

        .summary-head i {
            color: var(--accent);
            position: relative;
            z-index: 1;
        }

    .summary-body {
        padding: 24px 28px;
    }

    .product-summary {
        display: flex;
        gap: 16px;
        align-items: center;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--surface-3);
        margin-bottom: 20px;
    }

    .product-summary-img {
        width: 80px;
        height: 80px;
        border-radius: var(--radius-md);
        overflow: hidden;
        background: var(--surface-2);
        border: 1px solid var(--surface-3);
        flex-shrink: 0;
    }

        .product-summary-img img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 6px;
        }

    .product-summary-cat {
        font-size: 10px;
        font-weight: 700;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 4px;
    }

    .product-summary-name {
        font-size: 14px;
        font-weight: 700;
        color: var(--ink);
        line-height: 1.3;
        margin-bottom: 4px;
    }

    .product-summary-sub {
        font-size: 12px;
        color: var(--ink-muted);
    }

    .summary-line {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 14px;
        color: var(--ink-soft);
        margin-bottom: 12px;
    }

        .summary-line strong {
            color: var(--ink);
        }

        .summary-line .free {
            color: var(--green);
            font-weight: 700;
        }

    .summary-divider {
        border: none;
        border-top: 1px solid var(--surface-3);
        margin: 14px 0;
    }

    .summary-grand {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .summary-grand span {
            font-size: 15px;
            font-weight: 700;
            color: var(--ink);
        }

    .grand-val {
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem;
        font-weight: 900;
        color: var(--green);
        line-height: 1;
    }

        .grand-val sup {
            font-size: 0.6em;
            vertical-align: super;
            font-family: 'DM Sans', sans-serif;
        }

    .buy-now-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(232,54,93,0.08);
        border: 1px solid rgba(232,54,93,0.2);
        border-radius: 100px;
        padding: 6px 14px;
        font-size: 11px;
        font-weight: 700;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 20px;
    }

    .trust-strip {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid var(--surface-3);
    }

    .trust-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: var(--ink-muted);
        margin-bottom: 7px;
        font-weight: 500;
    }

        .trust-item i {
            color: var(--green);
            font-size: 11px;
        }

    @@media (max-width: 767px) {
        .field-row {
            grid-template-columns: 1fr;
        }

        .form-body {
            padding: 20px;
        }

        .form-section-head {
            padding: 18px 20px;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-back, .btn-place {
            width: 100%;
            justify-content: center;
        }

        .checkout-wrap {
            padding: 20px 0 60px;
        }

        .steps-inner {
            overflow-x: auto;
        }
    }
</style>

<!-- HERO -->
<div class="checkout-hero">
    <div class="container hero-inner">
        <div class="crumb-row">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i></a>
            <i class="fas fa-chevron-right"></i>
            <a asp-controller="Home" asp-action="Products">Products</a>
            <i class="fas fa-chevron-right"></i>
            @if (product != null)
            {
                <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@product.ProductId">@product.Name</a>
                <i class="fas fa-chevron-right"></i>
            }
            <span class="crumb-current">Quick Checkout</span>
        </div>
        <h1>Quick <em>Checkout</em></h1>
        <p class="checkout-hero-sub">Buying directly — complete your details below</p>
    </div>
</div>

<!-- Steps -->
<div class="checkout-steps">
    <div class="container p-0">
        <div class="steps-inner">
            <div class="step-item done">
                <div class="step-num"><i class="fas fa-check" style="font-size:11px;"></i></div>
                Product
            </div>
            <div class="step-item active">
                <div class="step-num">2</div>
                Shipping
            </div>
            <div class="step-item">
                <div class="step-num">3</div>
                Payment
            </div>
            <div class="step-item">
                <div class="step-num">4</div>
                Confirm
            </div>
        </div>
    </div>
</div>

<div class="checkout-wrap">
    <div class="container">
        <!-- ✅ Form posts to PlaceBuyNowOrder with all needed hidden fields -->
        <form asp-action="PlaceBuyNowOrder" method="post" id="buyNowCheckoutForm">
            @Html.AntiForgeryToken()

            <!-- Hidden fields: pass productId/quantity/sizeId/colorId to PlaceBuyNowOrder -->
            @if (product != null)
            {
                <input type="hidden" name="productId" value="@product.ProductId" />
            }
            <input type="hidden" name="quantity" value="@quantity" />
            @if (sizeId.HasValue)
            {
                <input type="hidden" name="sizeId" value="@sizeId.Value" />
            }
            @if (colorId.HasValue)
            {
                <input type="hidden" name="colorId" value="@colorId.Value" />
            }

            <div class="row g-4">
                <!-- LEFT: Form -->
                <div class="col-lg-8">

                    <!-- Contact Info -->
                    <div class="form-card">
                        <div class="form-section-head">
                            <div class="form-section-num">1</div>
                            <h5>Contact Information</h5>
                            <span class="section-note"><i class="fas fa-lock" style="color:var(--green);margin-right:4px;"></i> Auto-filled</span>
                        </div>
                        <div class="form-body">
                            <div class="field-row">
                                <div class="field-group">
                                    <label class="field-label">Full Name</label>
                                    <input type="text" class="field-input" value="@ViewBag.UserName" readonly>
                                </div>
                                <div class="field-group">
                                    <label class="field-label">Email Address</label>
                                    <input type="email" class="field-input" value="@ViewBag.UserEmail" readonly>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Shipping Address -->
                    <div class="form-card">
                        <div class="form-section-head">
                            <div class="form-section-num">2</div>
                            <h5>Shipping Address</h5>
                        </div>
                        <div class="form-body">
                            <div class="field-row single">
                                <div class="field-group">
                                    <label class="field-label">Complete Address <span class="req">*</span></label>
                                    <textarea name="shippingAddress" class="field-textarea" required
                                              placeholder="House/Flat No., Street, Area, City, State, PIN Code"></textarea>
                                </div>
                            </div>
                            <div class="field-row single">
                                <div class="field-group">
                                    <label class="field-label">Phone Number <span class="req">*</span></label>
                                    <input type="tel" name="phoneNumber" class="field-input" required
                                           placeholder="+91 XXXXX XXXXX"
                                           pattern="[0-9\-\+\s\(\)]+" title="Enter a valid phone number">
                                </div>
                            </div>
                            <div class="info-banner">
                                <i class="fas fa-info-circle"></i>
                                <span>Please double-check your address. Incorrect details may delay delivery.</span>
                            </div>
                        </div>
                    </div>

                    <!-- Payment -->
                    <div class="form-card">
                        <div class="form-section-head">
                            <div class="form-section-num">3</div>
                            <h5>Payment Method</h5>
                        </div>
                        <div class="form-body">
                            <div class="payment-options">
                                <label class="payment-option">
                                    <input type="radio" name="paymentMethod" value="cod" checked>
                                    <div class="pay-icon cod"><i class="fas fa-money-bill-wave"></i></div>
                                    <div class="pay-label">
                                        <strong>Cash on Delivery</strong>
                                        <span>Pay when your order arrives at your doorstep</span>
                                    </div>
                                </label>
                                <label class="payment-option disabled">
                                    <input type="radio" name="paymentMethod" value="card" disabled>
                                    <div class="pay-icon card"><i class="fas fa-credit-card"></i></div>
                                    <div class="pay-label">
                                        <strong>Credit / Debit Card</strong>
                                        <span>Visa, Mastercard, RuPay</span>
                                    </div>
                                    <span class="coming-tag">Coming Soon</span>
                                </label>
                                <label class="payment-option disabled">
                                    <input type="radio" name="paymentMethod" value="upi" disabled>
                                    <div class="pay-icon card"><i class="fas fa-mobile-alt"></i></div>
                                    <div class="pay-label">
                                        <strong>UPI / Digital Wallet</strong>
                                        <span>GPay, PhonePe, Paytm</span>
                                    </div>
                                    <span class="coming-tag">Coming Soon</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="form-actions">
                        @if (product != null)
                        {
                            <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@product.ProductId" class="btn-back">
                                <i class="fas fa-arrow-left"></i> Back to Product
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="Products" class="btn-back">
                                <i class="fas fa-arrow-left"></i> Back to Products
                            </a>
                        }
                        <button type="submit" class="btn-place">
                            <i class="fas fa-check-circle"></i> Place Order
                        </button>
                    </div>
                </div>

                <!-- RIGHT: Summary -->
                <div class="col-lg-4">
                    <div class="summary-card">
                        <div class="summary-head">
                            <i class="fas fa-bolt"></i>
                            <h5>Order Summary</h5>
                        </div>
                        <div class="summary-body">
                            <div class="buy-now-badge">
                                <i class="fas fa-bolt"></i> Buy Now — Direct Purchase
                            </div>

                            @if (product != null)
                            {
                                <div class="product-summary">
                                    <div class="product-summary-img">
                                        <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://via.placeholder.com/80" : product.ImageUrl)"
                                             alt="@product.Name">
                                    </div>
                                    <div>
                                        <div class="product-summary-cat">@product.Category?.Name</div>
                                        <div class="product-summary-name">@product.Name</div>
                                        @if (!string.IsNullOrEmpty(variantInfo))
                                        {
                                            <div class="product-summary-sub">Variant: @variantInfo</div>
                                        }
                                        <div class="product-summary-sub">Qty: @quantity × ₹@price.ToString("N0")</div>
                                    </div>
                                </div>
                            }

                            <div class="summary-line"><span>Subtotal</span><strong>₹@total.ToString("N0")</strong></div>
                            <div class="summary-line"><span>Shipping</span><span class="free"><i class="fas fa-check-circle"></i> FREE</span></div>
                            <div class="summary-line"><span>Tax</span><strong>₹0</strong></div>
                            <hr class="summary-divider">
                            <div class="summary-grand">
                                <span>Total</span>
                                <div class="grand-val"><sup>₹</sup>@total.ToString("N0")</div>
                            </div>

                            <div class="trust-strip">
                                <div class="trust-item"><i class="fas fa-shield-alt"></i> SSL Encrypted & Secure</div>
                                <div class="trust-item"><i class="fas fa-check-circle"></i> 100% Authentic Products</div>
                                <div class="trust-item"><i class="fas fa-undo"></i> Easy 30-Day Returns</div>
                                <div class="trust-item"><i class="fas fa-headset"></i> 24/7 Customer Support</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('buyNowCheckoutForm').addEventListener('submit', function(e) {
            const addr = this.querySelector('[name="shippingAddress"]').value.trim();
            const phone = this.querySelector('[name="phoneNumber"]').value.trim();
            if (!addr || !phone) {
                e.preventDefault();
                alert('Please fill in your shipping address and phone number.');
                return;
            }
            const btn = this.querySelector('.btn-place');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Placing Order...';
            btn.disabled = true;
        });
    </script>
}
