@model BrandsStore.Models.Order

@{
    ViewData["Title"] = "Order Confirmed";
}

<style>
    :root {
        --ink: #0a0a0f;
        --ink-soft: #3a3a4a;
        --ink-muted: #7a7a8c;
        --surface: #fff;
        --surface-2: #f4f4f8;
        --surface-3: #e6e6ee;
        --accent: #e8365d;
        --accent-dark: #c42548;
        --accent-glow: rgba(232,54,93,.09);
        --gold: #c9a227;
        --gold-glow: rgba(201,162,39,.09);
        --green: #00b074;
        --green-glow: rgba(0,176,116,.10);
        --blue: #3b82f6;
        --blue-glow: rgba(59,130,246,.09);
        --tr: all .3s cubic-bezier(.4,0,.2,1);
    }

    * {
        box-sizing: border-box;
    }

    .oc-page {
        font-family: 'DM Sans',sans-serif;
        background: var(--surface-2);
        min-height: 100vh;
        padding: 44px 20px 64px;
    }

    /* SUCCESS HERO */
    .oc-hero {
        max-width: 640px;
        margin: 0 auto 36px;
        text-align: center;
    }

    .oc-check-wrap {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 22px;
    }

    .oc-ring {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        background: var(--green-glow);
        border: 2px solid rgba(0,176,116,.2);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: ringPop .55s cubic-bezier(.34,1.56,.64,1) both;
    }

        .oc-ring i {
            font-size: 2.6rem;
            color: var(--green);
        }

    .oc-pulse {
        position: absolute;
        inset: -10px;
        border-radius: 50%;
        border: 2px solid rgba(0,176,116,.12);
        animation: pulsate 2.2s ease-out .5s infinite;
    }

    @@keyframes ringPop {
        from {
            opacity: 0;
            transform: scale(.4);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@keyframes pulsate {
        0% {
            transform: scale(1);
            opacity: 1;
        }

        100% {
            transform: scale(1.5);
            opacity: 0;
        }
    }

    .oc-title {
        font-family: 'Playfair Display',serif;
        font-size: clamp(1.8rem,4vw,2.5rem);
        font-weight: 900;
        color: var(--ink);
        margin: 0 0 10px;
    }

        .oc-title em {
            font-style: italic;
            color: var(--green);
        }

    .oc-sub {
        font-size: 14px;
        color: var(--ink-muted);
        line-height: 1.7;
        margin: 0 0 20px;
    }

    .oc-badge {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: var(--ink);
        color: #fff;
        border-radius: 100px;
        padding: 11px 26px;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: .4px;
    }

        .oc-badge span {
            color: var(--green);
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .oc-hero {
        animation: fadeUp .5s ease-out .1s both;
    }

    .oc-layout {
        animation: fadeUp .5s ease-out .25s both;
    }

    /* LAYOUT */
    .oc-layout {
        max-width: 880px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 310px;
        gap: 20px;
        align-items: start;
    }

    /* CARDS */
    .fc {
        background: #fff;
        border-radius: 18px;
        border: 1px solid var(--surface-3);
        overflow: hidden;
        margin-bottom: 18px;
    }

        .fc:last-child {
            margin-bottom: 0;
        }

    .fc-head {
        padding: 16px 22px;
        border-bottom: 1px solid var(--surface-3);
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .fc-ico {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        flex-shrink: 0;
    }

        .fc-ico.green {
            background: var(--green-glow);
            color: var(--green);
        }

        .fc-ico.blue {
            background: var(--blue-glow);
            color: var(--blue);
        }

        .fc-ico.gold {
            background: var(--gold-glow);
            color: var(--gold);
        }

    .fc-title {
        font-family: 'Playfair Display',serif;
        font-size: .95rem;
        font-weight: 700;
        color: var(--ink);
        margin: 0;
    }

    .fc-sub {
        font-size: 11px;
        color: var(--ink-muted);
        margin-top: 1px;
    }

    .fc-body {
        padding: 18px 22px;
    }

    /* ORDER ITEMS TABLE */
    .oi-table {
        width: 100%;
        border-collapse: collapse;
    }

        .oi-table thead th {
            padding: 9px 12px;
            font-size: 10px;
            font-weight: 800;
            color: var(--ink-muted);
            text-transform: uppercase;
            letter-spacing: .8px;
            background: var(--surface-2);
            border-bottom: 1.5px solid var(--surface-3);
        }

            .oi-table thead th:first-child {
                padding-left: 22px;
            }

        .oi-table tbody tr {
            border-bottom: 1px solid var(--surface-3);
            transition: var(--tr);
        }

            .oi-table tbody tr:last-child {
                border-bottom: none;
            }

            .oi-table tbody tr:hover {
                background: var(--surface-2);
            }

        .oi-table td {
            padding: 12px;
            vertical-align: middle;
        }

            .oi-table td:first-child {
                padding-left: 22px;
            }

    .oi-img {
        width: 46px;
        height: 46px;
        border-radius: 9px;
        object-fit: cover;
        border: 1.5px solid var(--surface-3);
    }

    .oi-no-img {
        width: 46px;
        height: 46px;
        border-radius: 9px;
        background: var(--surface-2);
        border: 1.5px solid var(--surface-3);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--ink-muted);
        font-size: 15px;
    }

    .oi-name {
        font-weight: 700;
        color: var(--ink);
        font-size: 13px;
    }

    .oi-cat {
        font-size: 11px;
        color: var(--ink-muted);
    }

    .oi-qty {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 7px;
        background: var(--surface-2);
        font-weight: 800;
        font-size: 12px;
        color: var(--ink);
    }

    .oi-price {
        font-size: 13px;
        font-weight: 700;
        color: var(--ink-soft);
    }

    .oi-total {
        font-family: 'Playfair Display',serif;
        font-size: .9rem;
        font-weight: 700;
        color: var(--ink);
    }

    .grand {
        font-family: 'Playfair Display',serif;
        font-size: 1.1rem;
        font-weight: 900;
        color: var(--green);
    }

    /* INFO LINES */
    .info-line {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        padding: 10px 0;
        border-bottom: 1px solid var(--surface-3);
    }

        .info-line:last-child {
            border-bottom: none;
        }

    .info-ico {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        background: var(--surface-2);
        color: var(--ink-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        flex-shrink: 0;
        margin-top: 1px;
    }

    .info-lbl {
        font-size: 10px;
        font-weight: 800;
        color: var(--ink-muted);
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 2px;
    }

    .info-val {
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
        line-height: 1.5;
    }

    /* SUMMARY */
    .sum-line {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 9px 0;
        border-bottom: 1px solid var(--surface-3);
        font-size: 13px;
    }

        .sum-line:last-child {
            border-bottom: none;
            padding-top: 12px;
        }

        .sum-line .sl {
            color: var(--ink-muted);
        }

        .sum-line .sv {
            font-weight: 700;
            color: var(--ink);
        }

        .sum-line.total .sv {
            font-family: 'Playfair Display',serif;
            font-size: 1.15rem;
            font-weight: 900;
            color: var(--green);
        }

    /* STATUS PILL */
    .sp-pending {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 11px;
        border-radius: 100px;
        font-size: 11px;
        font-weight: 700;
        background: var(--gold-glow);
        color: var(--gold);
    }

    /* NEXT STEPS TIMELINE */
    .ns-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid var(--surface-3);
    }

        .ns-item:last-child {
            border-bottom: none;
        }

    .ns-dot {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: var(--ink);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 800;
        flex-shrink: 0;
        margin-top: 1px;
    }

    .ns-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 2px;
    }

    .ns-sub {
        font-size: 11px;
        color: var(--ink-muted);
        line-height: 1.5;
    }

    /* ACTION BUTTONS */
    .action-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 4px;
    }

    .btn-primary-oc {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 100px;
        padding: 12px 26px;
        font-family: 'DM Sans',sans-serif;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
        transition: var(--tr);
    }

        .btn-primary-oc:hover {
            background: var(--accent-dark);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 26px rgba(232,54,93,.28);
        }

    .btn-secondary-oc {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #fff;
        color: var(--ink);
        border: 1.5px solid var(--surface-3);
        border-radius: 100px;
        padding: 11px 22px;
        font-family: 'DM Sans',sans-serif;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: var(--tr);
    }

        .btn-secondary-oc:hover {
            background: var(--ink);
            color: #fff;
            border-color: var(--ink);
        }

    @@media(max-width:860px) {
        .oc-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media(max-width:600px) {
        .oc-page {
            padding: 20px 14px 48px;
        }

        .fc-body {
            padding: 14px;
        }

        .fc-head {
            padding: 13px 16px;
        }
    }
</style>

<div class="oc-page">

    <!-- SUCCESS HERO -->
    <div class="oc-hero">
        <div class="oc-check-wrap">
            <div class="oc-ring"><i class="fas fa-check"></i></div>
            <div class="oc-pulse"></div>
        </div>
        <h1 class="oc-title">Order <em>Confirmed!</em></h1>
        <p class="oc-sub">Thank you for shopping with BrandsStore. Your order has been received and our team is preparing it with care.</p>
        <div class="oc-badge"><i class="fas fa-receipt"></i> Order <span>#@Model.OrderId.ToString("D4")</span></div>
    </div>

    <div class="oc-layout">

        <!-- LEFT: ITEMS + NEXT STEPS + ACTIONS -->
        <div>

            <!-- ORDER ITEMS -->
            <div class="fc">
                <div class="fc-head">
                    <div class="fc-ico green"><i class="fas fa-shopping-bag"></i></div>
                    <div>
                        <div class="fc-title">Your Items</div>
                        <div class="fc-sub">@(Model.OrderDetails?.Count ?? 0) item(s) ordered</div>
                    </div>
                </div>
                <div style="overflow-x:auto;">
                    <table class="oi-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Qty</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OrderDetails != null)
                            {
                                foreach (var item in Model.OrderDetails)
                                {
                                    <tr>
                                        <td>
                                            <div style="display:flex;align-items:center;gap:11px;">
                                                @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                                {
                                                    <img class="oi-img" src="@item.Product.ImageUrl" alt="@item.Product?.Name"
                                                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                                    <div class="oi-no-img" style="display:none;"><i class="fas fa-image"></i></div>
                                                }
                                                else
                                                {
                                                    <div class="oi-no-img"><i class="fas fa-image"></i></div>
                                                }
                                                <div>
                                                    <div class="oi-name">@item.Product?.Name</div>
                                                    <div class="oi-cat">@item.Product?.Category?.Name</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="oi-price">₹@item.UnitPrice.ToString("N2")</span></td>
                                        <td><span class="oi-qty">@item.Quantity</span></td>
                                        <td><span class="oi-total">₹@((item.UnitPrice * item.Quantity).ToString("N2"))</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" style="padding:12px 12px 12px 22px;text-align:right;color:var(--ink-muted);font-size:11px;text-transform:uppercase;letter-spacing:.5px;border-top:2px solid var(--surface-3);">Grand Total</td>
                                <td style="border-top:2px solid var(--surface-3);padding:12px;"><span class="grand">₹@Model.TotalAmount.ToString("N2")</span></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- WHAT'S NEXT -->
            <div class="fc">
                <div class="fc-head">
                    <div class="fc-ico blue"><i class="fas fa-route"></i></div>
                    <div>
                        <div class="fc-title">What Happens Next?</div>
                        <div class="fc-sub">Your order journey from here</div>
                    </div>
                </div>
                <div class="fc-body">
                    <div class="ns-item">
                        <div class="ns-dot" style="background:var(--green);">✓</div>
                        <div><div class="ns-title">Order Confirmed</div><div class="ns-sub">Your order is placed and payment has been verified successfully.</div></div>
                    </div>
                    <div class="ns-item">
                        <div class="ns-dot">2</div>
                        <div><div class="ns-title">Processing</div><div class="ns-sub">Our team will pick, pack, and quality-check your items.</div></div>
                    </div>
                    <div class="ns-item">
                        <div class="ns-dot">3</div>
                        <div><div class="ns-title">Shipped</div><div class="ns-sub">Your package will be dispatched and a tracking number provided.</div></div>
                    </div>
                    <div class="ns-item">
                        <div class="ns-dot" style="background:var(--green);">4</div>
                        <div><div class="ns-title">Delivered</div><div class="ns-sub">Estimated delivery: 3–5 business days. Enjoy your purchase!</div></div>
                    </div>
                </div>
            </div>

            <!-- ACTIONS -->
            <div class="action-row">
                <a asp-controller="Cart" asp-action="MyOrders" class="btn-primary-oc">
                    <i class="fas fa-list-alt"></i> View My Orders
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn-secondary-oc">
                    <i class="fas fa-store"></i> Continue Shopping
                </a>
            </div>
        </div>

        <!-- RIGHT SIDEBAR -->
        <div>

            <!-- SUMMARY -->
            <div class="fc" style="margin-bottom:18px;">
                <div class="fc-head">
                    <div class="fc-ico green"><i class="fas fa-receipt"></i></div>
                    <div>
                        <div class="fc-title">Order Summary</div>
                        <div class="fc-sub">Payment breakdown</div>
                    </div>
                </div>
                <div class="fc-body">
                    <div class="sum-line"><span class="sl">Order ID</span><span class="sv">#@Model.OrderId.ToString("D4")</span></div>
                    <div class="sum-line"><span class="sl">Date</span><span class="sv">@Model.OrderDate.ToString("dd MMM yyyy")</span></div>
                    <div class="sum-line"><span class="sl">Status</span><span class="sv"><span class="sp-pending"><i class="fas fa-clock"></i> @Model.Status</span></span></div>
                    <div class="sum-line"><span class="sl">Items</span><span class="sv">@(Model.OrderDetails?.Sum(od => od.Quantity) ?? 0)</span></div>
                    <div class="sum-line"><span class="sl">Shipping</span><span class="sv" style="color:var(--green);font-weight:700;">FREE</span></div>
                    <div class="sum-line total">
                        <span class="sl" style="font-size:14px;font-weight:700;color:var(--ink);">Total Paid</span>
                        <span class="sv">₹@Model.TotalAmount.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <!-- DELIVERY -->
            <div class="fc">
                <div class="fc-head">
                    <div class="fc-ico gold"><i class="fas fa-map-marker-alt"></i></div>
                    <div>
                        <div class="fc-title">Delivery Details</div>
                        <div class="fc-sub">Where we're sending it</div>
                    </div>
                </div>
                <div class="fc-body" style="padding:6px 22px;">
                    <div class="info-line">
                        <div class="info-ico"><i class="fas fa-map-marker-alt"></i></div>
                        <div>
                            <div class="info-lbl">Shipping Address</div>
                            <div class="info-val">@Model.ShippingAddress</div>
                        </div>
                    </div>
                    <div class="info-line">
                        <div class="info-ico"><i class="fas fa-phone"></i></div>
                        <div>
                            <div class="info-lbl">Phone</div>
                            <div class="info-val">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "N/A" : Model.PhoneNumber)</div>
                        </div>
                    </div>
                    <div class="info-line">
                        <div class="info-ico"><i class="fas fa-truck"></i></div>
                        <div>
                            <div class="info-lbl">Estimated Delivery</div>
                            <div class="info-val">3–5 business days</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
